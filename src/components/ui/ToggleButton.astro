---
interface Props {
  id?: string;
  ariaLabel: string;
  onclick?: string;
  icon: string;
  text?: string;
  activeIcon?: string;
  lightModeIconColor?: string;
  darkModeIconColor?: string;
  defaultIconColor?: string;
  class?: string;
}

const {
  id,
  ariaLabel,
  onclick,
  icon,
  text,
  activeIcon,
  lightModeIconColor = 'text-secondary',
  darkModeIconColor = 'text-secondary',
  defaultIconColor = 'text-secondary',
  class: className = ''
} = Astro.props;
---

<button
	id={id}
	aria-label={ariaLabel}
	onclick={onclick}
	class={`w-[54px] h-[54px] flex items-center justify-center rounded-2xl bg-elevated border border-border hover:bg-border focus:outline-none transition-colors duration-500 ease-spatial ${className}`}
>
  {text ? (
    <span class={`${defaultIconColor} text-2xl font-bold leading-none block`}>{text}</span>
  ) : activeIcon ? (
    <>
      <span class={`${icon} ${lightModeIconColor} text-2xl dark:hidden block`} aria-hidden="true"></span>
      <span class={`${activeIcon} ${darkModeIconColor} text-2xl hidden dark:block`} aria-hidden="true"></span>
    </>
  ) : (
    <span class={`${icon} ${defaultIconColor} text-2xl block`} aria-hidden="true"></span>
  )}
</button>
