---
import ToggleButton from './ToggleButton.astro';
import { getLangFromUrl } from '../../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const targetLang = currentLang === 'es' ? 'en' : 'es';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cleanPath = Astro.url.pathname.replace(base, '').replace(/^\//, '');
let targetPath: string;
if (currentLang === 'es') {
  targetPath = `${base}en/${cleanPath}`;
} else {
  targetPath = `${base}${cleanPath.replace(/^en\/?/, '')}`;
}
---

<div class="fixed bottom-6 left-6 md:bottom-auto md:left-auto md:top-6 md:right-12 z-50 flex flex-row-reverse md:flex-row items-center gap-4">
  <ToggleButton
    id="lang-toggle"
    href={targetPath}
    data-base-path={targetPath}
    ariaLabel={`Switch to ${targetLang === 'en' ? 'English' : 'Español'}`}
    text={targetLang.toUpperCase()}
    defaultIconColor="text-secondary"
  />
  <ToggleButton
    id="theme-toggle"
    ariaLabel="Toggle Theme"
    icon="icon-[ic--outline-dark-mode]"
    activeIcon="icon-[ic--outline-light-mode]"
    lightModeIconColor="text-brand-dominant-500"
    darkModeIconColor="text-brand-action-500"
  />
</div>

<script>
  function updateLangHref() {
    const langLink = document.getElementById('lang-toggle') as HTMLAnchorElement | null;
    if (!langLink) return;
    const basePath = langLink.dataset.basePath || langLink.pathname;
    const hash = window.location.hash || '';
    langLink.href = `${basePath}${hash}`;
  }

  window.addEventListener('hashchange', updateLangHref);
  document.addEventListener('astro:after-swap', updateLangHref);
  updateLangHref();
</script>
