---
import ContactPetSvg from '../../assets/contact_pet_v2.svg';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`contact-pet-wrap relative ${className ?? ''}`}>
	<ContactPetSvg class="contact-pet-svg block w-full h-auto" fill="currentColor" />
</div>

<style is:global>
	.contact-pet-wrap {
		isolation: isolate;
		overflow: visible;
		filter: none;
	}

	/* Halo envolvente que contornea la silueta del carpincho (solo dark).
	   drop-shadow() usa el canal alpha del contenido renderizado, así el glow
	   sigue EXACTAMENTE la forma del animal (no el viewBox cuadrado del SVG).
	   Dos capas balancean efecto vs. rendimiento: una exterior amplia y suave
	   (96px, halo de fondo) + una interior más intensa (28px, silueta definida).
	   Se eliminó la cadena de 5 sombras con blur de hasta 560px, que forzaba
	   superficies de rasterizado enormes al hacer scroll. No altera posiciones
	   ni dimensiones. */
	.dark.theme-glow-ready .contact-pet-svg {
		filter:
			drop-shadow(0 0 370px rgba(0, 173, 255, 0.30))
			drop-shadow(0 0 32px rgba(0, 173, 255, 0.75));
	}
</style>
