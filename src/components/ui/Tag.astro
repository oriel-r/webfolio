---
interface Props {
  variant?: 'tech' | 'default' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  class?: string;
  /** Slugs de proyectos a los que enlaza. Si se pasa, el tag se vuelve un <button> clicable. */
  linkToProjects?: string[];
  ariaLabel?: string;
}

const {
  variant = 'tech',
  size = 'sm',
  icon,
  class: className = '',
  linkToProjects,
  ariaLabel,
  ...rest
} = Astro.props;

const isLink = Array.isArray(linkToProjects) && linkToProjects.length > 0;

const baseStyles = 'inline-flex items-center gap-[0.6em] tracking-[0.04em] font-medium rounded-full transition duration-pill ease-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 font-code';

const variants = {
  tech: isLink
    ? 'bg-surface/50 text-primary border border-border-subtle hover:bg-accent/15 hover:border-accent/60 cursor-pointer focus-visible:ring-focus-ring/70'
    : 'bg-surface/50 text-primary border border-border-subtle hover:bg-primary/8',
  default: 'bg-elevated text-primary hover:bg-border',
  outline: 'text-primary border border-border',
};

const sizes = {
  sm: 'px-2 py-0.5 text-xs',
  md: 'px-2.5 py-1 text-sm',
  lg: 'px-3 py-1.5 text-base',
};

const classes = [baseStyles, variants[variant], sizes[size], className].filter(Boolean).join(' ');
const Tag = isLink ? 'button' : 'span';
const extraAttrs = isLink
  ? {
      type: 'button',
      'data-tech-projects': linkToProjects!.join(','),
      'aria-label': ariaLabel,
    }
  : {};
---

<Tag class={classes} {...extraAttrs} {...rest}>
  {icon && (
    <span class={`icon-[simple-icons--${icon}] inline-block text-[1em] shrink-0 text-muted opacity-70`} aria-hidden="true"></span>
  )}
  <slot />
</Tag>