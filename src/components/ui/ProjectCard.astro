---
import Card from './Card.astro';
import Tag from './Tag.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  tags?: string[];
  link?: string;
}

const { title, description, image, tags = [], link } = Astro.props;
---

<Card as="article" class="flex flex-col overflow-hidden h-full">
  {image && (
    <div class="aspect-video w-full overflow-hidden bg-elevated">
      <img src={image} alt={`Screenshot of ${title}`} class="w-full h-full object-cover transition-transform hover:scale-105 duration-500" loading="lazy" />
    </div>
  )}
  <div class="p-6 flex flex-col flex-grow">
    <h3 class="text-xl font-bold text-primary mb-2 font-code">{title}</h3>
    <p class="text-secondary mb-4 flex-grow text-sm">{description}</p>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4 mt-auto">
        {tags.map((tag) => (
          <Tag variant="outline">{tag}</Tag>
        ))}
      </div>
    )}

    {link && (
      <div class="mt-4 pt-4 border-t border-border-subtle">
        <a href={link} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-primary hover:underline">
          View Project &rarr;
        </a>
      </div>
    )}
  </div>
</Card>
