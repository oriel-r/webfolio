---
import HeroPetSvg from '../../assets/hero_pet_aggressive_v2.svg';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`hero-pet-wrap relative ${className ?? ''}`}>
	<HeroPetSvg class="block w-full h-auto" fill="currentColor" />
</div>

<style is:global>
	/* Stack context del wrap: confina el z-index:-1 del ::after DENTRO
	   del wrap (detrás del SVG, pero delante del bg opaco del body).
	   overflow: visible garantiza que el halo extendido del ::after
	   pueda pintar fuera de los bordes del wrap. */
	:global(.hero-pet-wrap) {
		isolation: isolate;
		overflow: visible;
	}

	/* Color de la sombra de contacto del HeroPet, por tema.
	   El <filter> del SVG deja un feFlood con flood-color por defecto que
	   aquí se sobreescribe. Light: oclusión oscura legible sobre canvas claro.
	   Dark: sobre canvas casi-negro una sombra oscura no se ve, así que usamos
	   glow dominante más opaco para dar la misma lectura de "posado". */
	:global(#hero-shadow-flood) {
		flood-color: #0C0F10;
		flood-opacity: 0.32;
		transition:
			flood-color var(--duration-base) var(--ease-spatial),
			flood-opacity var(--duration-base) var(--ease-spatial);
	}
	:global(.dark) :global(#hero-shadow-flood) {
		flood-color: #71D1FF;
		flood-opacity: 0.55;
	}

	/* Glow "blass light" envolvente detrás del carpincho, solo dark.
	   Backdrop azul casi opaco: núcleo saturado (dominant500) que cubre
	   toda la silueta y se desvanece solo en los bordes extremos, para
	   que el carpincho (dominant900 #00131C) se recorte contra él como
	   un punch-out. El ::after se extiende más allá del wrap (160%×135%)
	   para garantizar cobertura total del área del SVG + halo envolvente.
	   Sin blur → color saturado, no lavado. */
	:global(.dark .hero-pet-wrap)::after {
		content: "";
		position: absolute;
		left: 50%;
		top: 50%;
		width: 160%;
		height: 135%;
		transform: translate(-50%, -50%);
		background: radial-gradient(ellipse 75% 70% at 50% 50%, #00ADFF 0%, #00ADFF 40%, rgba(0,173,255,0.4) 75%, transparent 100%);
		opacity: 0;
		filter: blur(2px);
		pointer-events: none;
		z-index: -1;
		transition: opacity var(--duration-base) var(--ease-spatial);
	}
	:global(.dark) :global(.hero-pet-wrap)::after {
		opacity: 1;
	}
</style>