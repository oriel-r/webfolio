---
import HeroPetSvg from '../../assets/hero_pet_aggressive_v2.svg';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`hero-pet-wrap relative ${className ?? ''}`}>
	<HeroPetSvg
		class="hero-pet-glow absolute inset-0 block w-full h-auto z-0 pointer-events-none opacity-0 dark:opacity-100 transition-opacity duration-base ease-spatial"
		fill="currentColor"
		aria-hidden="true"
	/>
	<HeroPetSvg class="hero-pet-svg block w-full h-auto relative z-[1]" fill="currentColor" />
</div>

<style is:global>
	/* Stack context del wrap: confina el z-index del SVG dentro de un
	   contexto estable. */
	.hero-pet-wrap {
		isolation: isolate;
		overflow: visible;
		filter: none;
	}

	/* Color de la sombra de contacto del HeroPet, por tema.
	   El <filter> del SVG deja un feFlood con flood-color por defecto que
	   aquí se sobreescribe. Light: oclusión oscura legible sobre canvas claro.
	   Dark: sobre canvas casi-negro una sombra oscura no se ve, así que usamos
	   glow dominante más opaco para dar la misma lectura de "posado". */
	#hero-shadow-flood {
		flood-color: #0C0F10;
		flood-opacity: 0.32;
		transition:
			flood-color var(--duration-base) var(--ease-spatial),
			flood-opacity var(--duration-base) var(--ease-spatial);
	}
	.dark #hero-shadow-flood {
		flood-color: #00ADFF;
		flood-opacity: 0.55;
	}

	/* Halo envolvente que contornea la silueta del carpincho (solo dark).
	   Se aplica a una capa dedicada (.hero-pet-glow) con filtro estático y
	   transición de `opacity`. Esto permite a la GPU componer el halo suavemente
	   sin recalcular el blur de 370px en cada frame y sin retardos ni destellos. */
	.hero-pet-glow {
		filter:
			drop-shadow(0 0 370px color-mix(in srgb, var(--color-brand-dominant-500) 30%, transparent))
			drop-shadow(0 0 64px color-mix(in srgb, var(--color-brand-dominant-400) 75%, transparent));
	}
</style>
