---
import HeroPetSvg from '../../assets/hero_pet_aggressive_v2.svg';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`hero-pet-wrap relative ${className ?? ''}`}>
	<HeroPetSvg class="hero-pet-svg block w-full h-auto relative z-[1]" fill="currentColor" />
</div>

<style is:global>
	/* Stack context del wrap: confina el z-index del SVG dentro de un
	   contexto estable. overflow: visible no es estrictamente necesario
	   para drop-shadow (el halo se pinta sobre el canvas de la capa),
	   pero se conserva por seguridad.
   El halo no se anima mediante `filter`: los blur grandes se recalculan
   en cada frame y provocaban tirones. El estado `.theme-glow-ready` se
   añade por JS después de que terminan las transiciones de la página. */
	.hero-pet-wrap {
		isolation: isolate;
		overflow: visible;
		filter: none;
	}

	/* Color de la sombra de contacto del HeroPet, por tema.
	   El <filter> del SVG deja un feFlood con flood-color por defecto que
	   aquí se sobreescribe. Light: oclusión oscura legible sobre canvas claro.
	   Dark: sobre canvas casi-negro una sombra oscura no se ve, así que usamos
	   glow dominante más opaco para dar la misma lectura de "posado". */
	#hero-shadow-flood {
		flood-color: #0C0F10;
		flood-opacity: 0.32;
		transition:
			flood-color var(--duration-base) var(--ease-spatial),
			flood-opacity var(--duration-base) var(--ease-spatial);
	}
	.dark #hero-shadow-flood {
		flood-color: #00ADFF;
		flood-opacity: 0.55;
	}

	/* Halo envolvente que contornea la silueta del carpincho (solo dark).
	   Se aplica SOLO a la base (.hero-pet-svg), no al wrap (consistencia
	   con ContactPet: el halo vive en la base y no envuelve a otras capas).
	   drop-shadow() usa el canal alpha del contenido renderizado, así el
	   glow sigue EXACTAMENTE la forma del animal (no el viewBox cuadrado
	   del SVG); conserva la sombra interna del HeroPet (filter
	   url(#hero-ground-shadow) se evalúa como parte del contenido).
	   Halo exterior amplio en dominant-500 + halo interno fino en
	   dominant-400 para contornear la silueta dominant-900 (punch-out). */
	.dark.theme-glow-ready .hero-pet-svg {
		filter:
			drop-shadow(0 0 370px color-mix(in srgb, var(--color-brand-dominant-500) 30%, transparent))
			drop-shadow(0 0 64px color-mix(in srgb, var(--color-brand-dominant-400) 75%, transparent));
		/* Se aplica una sola vez, ya con la página estable, en lugar de
		   interpolar un blur de 370px durante cientos de frames. */
	}
</style>
