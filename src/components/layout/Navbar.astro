---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { href: '#hero', label: t('nav.home') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#about', label: t('nav.about') },
  { href: '#technologies', label: t('nav.technologies') },
  { href: '#contact', label: t('nav.contact') },
];
---

<!-- Mobile: horizontal carousel navbar -->
<nav class="fixed top-0 left-0 right-0 z-50 md:hidden">
  <div id="mobile-nav" class="overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth">
    <ul class="flex items-center gap-8 w-max py-6 px-[50vw]">
      {navItems.map((item, i) => (
        <li>
          <a
            href={item.href}
            data-nav-index={i}
            class="nav-mobile-link shrink-0 text-xl font-medium text-muted hover:text-accent transition-colors snap-center"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<!-- Desktop: original navbar -->
<nav class="fixed top-0 left-0 right-0 z-50 py-6 px-12 hidden md:flex justify-center items-center gap-12 pointer-events-none">
  <div class="pointer-events-auto">
    <ul class="flex items-center gap-4 sm:gap-6">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="text-sm font-medium text-muted hover:text-accent transition-colors"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  function initMobileNav() {
    const mobileNav = document.getElementById('mobile-nav');
    if (!mobileNav) return;

    const links = mobileNav.querySelectorAll<HTMLAnchorElement>('.nav-mobile-link');

    function setActive(index: number) {
      links.forEach((link, i) => {
        if (i === index) {
          link.classList.add('text-accent');
          link.classList.remove('text-muted');
        } else {
          link.classList.remove('text-accent');
          link.classList.add('text-muted');
        }
      });
    }

    function centerLink(index: number) {
      const link = links[index];
      if (!link || !mobileNav) return;
      const linkCenter = link.offsetLeft + link.offsetWidth / 2;
      const containerCenter = mobileNav.clientWidth / 2;
      mobileNav.scrollTo({
        left: linkCenter - containerCenter,
        behavior: 'smooth',
      });
    }

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const index = Number(link.dataset.navIndex);
        window.dispatchEvent(
          new CustomEvent('navClick', { detail: { index } }),
        );
        setActive(index);
        centerLink(index);
      });
    });

    window.addEventListener('sectionChange', ((e: CustomEvent) => {
      const index = e.detail.index;
      setActive(index);
      centerLink(index);
    }) as EventListener);

    setActive(0);
    requestAnimationFrame(() => centerLink(0));
  }

  document.addEventListener('astro:after-swap', initMobileNav);
  initMobileNav();
</script>
