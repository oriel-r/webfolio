---
import { useTranslations } from '../../i18n/utils';

interface Props {
  slug: string;
  name: string;
  type: string;
  description: string;
  long_description?: string;
  images: string[];
  colaborators?: { name?: string; contact: string }[];
  technologies: string[];
  role?: string;
  demo?: string;
  repository: string;
  back_repo?: string;
  front_repo?: string;
  lang: 'es' | 'en';
}

const {
  slug,
  name,
  type,
  description,
  long_description,
  images,
  colaborators = [],
  technologies,
  role,
  demo,
  repository,
  back_repo,
  front_repo,
  lang,
} = Astro.props;

const t = useTranslations(lang);
const totalImages = images.length;
const galleryId = `gallery-${slug}`;

const collaboratorText =
  colaborators.length > 0
    ? colaborators.map((c) => c.name ?? '').filter(Boolean).join(', ')
    : t('detail.noColaborators');

const repositoryLabel = t('detail.close') === 'Close' ? 'Repository' : 'Repositorio';
---

<div class="project-detail relative w-full min-h-screen md:h-screen flex flex-col md:flex-row bg-canvas text-primary overflow-hidden project-detail-page">

  <!-- Close button (top-right) -->
  <a
    href={lang === 'en' ? '/en/#projects' : '/#projects'}
    aria-label={t('detail.close')}
    class="close-btn absolute top-4 right-4 md:top-6 md:right-6 z-30 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-2xl bg-canvas/80 backdrop-blur-sm hover:bg-elevated border border-border text-primary focus:outline-none transition-colors duration-500 ease-spatial"
  >
    <span class="icon-[ic--outline-close] text-2xl block" aria-hidden="true"></span>
  </a>

  <!-- Gallery column (left on desktop / top on mobile) -->
  <section
    class="project-gallery relative w-full md:w-1/2 h-[55vh] md:h-full shrink-0 overflow-hidden bg-elevated"
    style={`view-transition-name: project-${slug}-gallery;`}
  >
    <!-- Image counter (top-left of gallery, matches mockup 1/4 pill) -->
    <div
      class="absolute top-4 left-4 md:top-6 md:left-6 z-20 px-3 py-1.5 rounded-md bg-canvas/90 backdrop-blur-sm border border-border"
      aria-live="polite"
    >
      <span class="text-sm font-medium font-code text-primary" data-counter>
        <span data-counter-current>1</span>/{totalImages}
      </span>
    </div>

    <!-- Radios (driven by labels & swipe) -->
    <div class="sr-only" data-radios>
      {Array.from({ length: totalImages }).map((_, i) => (
        <input
          type="radio"
          name={galleryId}
          id={`${galleryId}-${i}`}
          checked={i === 0}
          data-gallery-input
          data-index={i}
        />
      ))}
    </div>

    <!-- Big slide stage -->
    <div class="absolute inset-0">
      {images.map((src, i) => (
        <img
          src={src}
          alt={`${name} - ${i + 1}`}
          class="gallery-slide absolute inset-0 w-full h-full object-cover"
          loading={i === 0 ? 'eager' : 'lazy'}
          data-slide={i}
        />
      ))}
    </div>
  </section>

  <!-- Details column -->
  <section class="details relative w-full md:w-1/2 flex-1 md:h-full overflow-y-auto px-6 py-16 md:px-12 md:py-12 md:pt-20 bg-canvas">
    <header class="max-w-xl mx-auto md:mx-0">
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-display font-medium tracking-tight text-primary mb-2">
        {name}
      </h1>
      <p class="text-sm md:text-base text-muted font-code uppercase tracking-wider">
        {role ?? type}
      </p>
    </header>

    <!-- Thumbnails (each label drives the radio) -->
    <div class="mt-8 md:mt-10 max-w-xl mx-auto md:mx-0">
      <div class={`grid gap-2 ${totalImages <= 4 ? 'grid-cols-4' : 'grid-cols-3'}`}>
        {images.map((src, i) => (
          <label
            for={`${galleryId}-${i}`}
            class="thumb block aspect-square rounded-md overflow-hidden cursor-pointer border border-border bg-elevated transition-all duration-500 ease-spatial hover:scale-[1.02]"
            aria-label={`Go to image ${i + 1}`}
          >
            <img
              src={src}
              alt={`${name} thumbnail ${i + 1}`}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </label>
        ))}
      </div>

      <p class="mt-6 text-base text-secondary leading-relaxed">
        {long_description ?? description}
      </p>
    </div>

    <!-- Colaboradores -->
    <div class="mt-10 max-w-xl mx-auto md:mx-0">
      <h2 class="text-lg md:text-xl font-display font-medium text-primary mb-2">
        {t('detail.colaborators')}
      </h2>
      <p class="text-sm md:text-base text-secondary leading-relaxed">
        {collaboratorText}
      </p>
    </div>

    <!-- Tecnologías + acciones -->
    <div class="mt-10 max-w-xl mx-auto md:mx-0">
      <h2 class="text-lg md:text-xl font-display font-medium text-primary mb-4">
        {t('detail.technologies')}
      </h2>
      <div class="flex flex-wrap gap-2">
        {technologies.map((tech) => (
          <span class="inline-flex items-center rounded-md px-2.5 py-1 bg-elevated text-primary font-code text-xs font-medium border border-border">
            {tech}
          </span>
        ))}
      </div>

      <!-- Action buttons (Demo / Back-end / Front-end) -->
      <div class="flex flex-wrap gap-3 mt-6 mb-12">
        {demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-canvas text-primary border border-border hover:bg-elevated focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-500 ease-spatial text-sm"
          >
            <span class="icon-[ic--outline-play-circle] text-lg" aria-hidden="true"></span>
            <span>{t('detail.demo')}</span>
          </a>
        )}
        {back_repo && (
          <a
            href={back_repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-canvas text-primary border border-border hover:bg-elevated focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-500 ease-spatial text-sm"
          >
            <span class="icon-[ic--outline-code] text-lg" aria-hidden="true"></span>
            <span>{t('detail.backend')}</span>
          </a>
        )}
        {front_repo && (
          <a
            href={front_repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-canvas text-primary border border-border hover:bg-elevated focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-500 ease-spatial text-sm"
          >
            <span class="icon-[ic--outline-code] text-lg" aria-hidden="true"></span>
            <span>{t('detail.frontend')}</span>
          </a>
        )}
        {!back_repo && !front_repo && (
          <a
            href={repository}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-canvas text-primary border border-border hover:bg-elevated focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-500 ease-spatial text-sm"
          >
            <span class="icon-[ic--outline-code] text-lg" aria-hidden="true"></span>
            <span>Repository</span>
          </a>
        )}
      </div>
    </div>
  </section>
</div>

<style>
  /* Gallery: CSS-only image switcher using sibling radios */
  .project-gallery [data-gallery-input] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 1px;
    height: 1px;
  }

  .project-gallery .gallery-slide {
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-spatial);
  }
  .project-gallery .gallery-slide[data-slide='0'] {
    opacity: 1;
  }

  .project-gallery:has([data-gallery-input][data-index='1']:checked) .gallery-slide[data-slide='0'],
  .project-gallery:has([data-gallery-input][data-index='2']:checked) .gallery-slide[data-slide='0'],
  .project-gallery:has([data-gallery-input][data-index='3']:checked) .gallery-slide[data-slide='0'] {
    opacity: 0;
  }

  .project-gallery:has([data-gallery-input][data-index='1']:checked) .gallery-slide[data-slide='1'],
  .project-gallery:has([data-gallery-input][data-index='2']:checked) .gallery-slide[data-slide='2'],
  .project-gallery:has([data-gallery-input][data-index='3']:checked) .gallery-slide[data-slide='3'] {
    opacity: 1;
  }

  /* Thumbnails: active ring via :has on gallery section */
  .project-gallery:has([data-gallery-input][data-index='0']:checked) ~ .details .thumb[for$='-0'],
  .project-gallery:has([data-gallery-input][data-index='1']:checked) ~ .details .thumb[for$='-1'],
  .project-gallery:has([data-gallery-input][data-index='2']:checked) ~ .details .thumb[for$='-2'],
  .project-gallery:has([data-gallery-input][data-index='3']:checked) ~ .details .thumb[for$='-3'] {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Counter: replace inner text via CSS (no JS) */
  .project-gallery [data-counter-current] {
    /* default = 1 */
  }
  .project-gallery:has([data-gallery-input][data-index='1']:checked) [data-counter-current] {
    visibility: hidden;
    position: relative;
  }
  .project-gallery:has([data-gallery-input][data-index='1']:checked) [data-counter-current]::before {
    content: '2';
    visibility: visible;
    position: absolute;
    inset: 0;
  }

  .project-gallery:has([data-gallery-input][data-index='2']:checked) [data-counter-current] {
    visibility: hidden;
    position: relative;
  }
  .project-gallery:has([data-gallery-input][data-index='2']:checked) [data-counter-current]::before {
    content: '3';
    visibility: visible;
    position: absolute;
    inset: 0;
  }

  .project-gallery:has([data-gallery-input][data-index='3']:checked) [data-counter-current] {
    visibility: hidden;
    position: relative;
  }
  .project-gallery:has([data-gallery-input][data-index='3']:checked) [data-counter-current]::before {
    content: '4';
    visibility: visible;
    position: absolute;
    inset: 0;
  }
</style>

<script>
  // Minimal swipe handler for mobile gallery
  function initSwipe() {
    const galleries = document.querySelectorAll<HTMLElement>('.project-gallery');
    galleries.forEach((gallery) => {
      if ((gallery as any).dataset.swipeReady === '1') return;
      (gallery as any).dataset.swipeReady = '1';

      const inputs = gallery.querySelectorAll<HTMLInputElement>('[data-gallery-input]');
      if (inputs.length < 2) return;

      let startX = 0;
      let startY = 0;

      gallery.addEventListener(
        'touchstart',
        (e) => {
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
        },
        { passive: true },
      );

      gallery.addEventListener(
        'touchend',
        (e) => {
          const dx = startX - e.changedTouches[0].clientX;
          const dy = startY - e.changedTouches[0].clientY;
          if (Math.abs(dx) < 40 || Math.abs(dy) > Math.abs(dx)) return;

          const current = Array.from(inputs).findIndex((i) => i.checked);
          if (current === -1) return;
          const next = dx > 0
            ? Math.min(current + 1, inputs.length - 1)
            : Math.max(current - 1, 0);

          inputs[next].checked = true;
          inputs[next].dispatchEvent(new Event('change', { bubbles: true }));
        },
        { passive: true },
      );
    });
  }

  document.addEventListener('astro:page-load', initSwipe);
</script>
