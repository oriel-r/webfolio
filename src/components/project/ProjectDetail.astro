---
import { useTranslations } from '../../i18n/utils';

interface Props {
  slug: string;
  name: string;
  type: string;
  description: string;
  long_description?: string;
  images: string[];
  colaborators?: { name?: string; contact: string }[];
  technologies: string[];
  role?: string;
  demo?: string;
  repository: string;
  back_repo?: string;
  front_repo?: string;
  lang: 'es' | 'en';
}

const {
  slug,
  name,
  type,
  description,
  long_description,
  images,
  colaborators = [],
  technologies,
  role,
  demo,
  repository,
  back_repo,
  front_repo,
  lang,
} = Astro.props;

const t = useTranslations(lang);
const totalImages = images.length;
const galleryId = `gallery-${slug}`;

const collaboratorText =
  colaborators.length > 0
    ? colaborators.map((c) => c.name ?? '').filter(Boolean).join(', ')
    : '';
---

<div class="project-detail relative w-full min-h-screen md:h-screen flex flex-col md:flex-row bg-canvas text-primary overflow-hidden project-detail-page" data-project-slug={slug}>

  <!-- Close button (top-right) -->
  <a
    href={lang === 'en' ? '/en/#projects' : '/#projects'}
    aria-label={t('detail.close')}
    class="close-btn absolute top-4 right-4 md:top-6 md:right-6 z-30 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center rounded-2xl bg-canvas/80 backdrop-blur-sm hover:bg-elevated border border-border text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-focus-ring transition duration-hover ease-hover"
  >
    <span class="icon-[ic--outline-close] text-2xl block" aria-hidden="true"></span>
  </a>

  <!-- Gallery column (left on desktop / top on mobile) -->
  <section
    class="project-gallery relative w-full md:w-1/2 aspect-square md:aspect-auto md:h-full shrink-0 overflow-hidden bg-elevated"
    style={`view-transition-name: project-${slug}-gallery;`}
  >
    <!-- Radios (driven by labels & swipe) -->
    <div class="sr-only" data-radios>
      {Array.from({ length: totalImages }).map((_, i) => (
        <input
          type="radio"
          name={galleryId}
          id={`${galleryId}-${i}`}
          checked={i === 0}
          data-gallery-input
          data-index={i}
        />
      ))}
    </div>

    <!-- Scrollable image track -->
    <div class="gallery-track absolute inset-0 flex md:flex-col overflow-x-auto md:overflow-x-hidden md:overflow-y-auto snap-x md:snap-y snap-mandatory scrollbar-hide overscroll-x-contain md:overscroll-y-contain md:overscroll-x-auto">
      {images.map((src, i) => (
        <img
          src={src}
          alt={`${name} - ${i + 1}`}
          class="gallery-slide flex-none w-full md:w-auto md:h-full object-cover"
          loading={i === 0 ? 'eager' : 'lazy'}
          data-slide={i}
        />
      ))}
    </div>

    <!-- Dot indicators -->
    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 md:bottom-auto md:right-4 md:left-auto md:top-1/2 md:-translate-y-1/2 md:translate-x-0 z-20 flex md:flex-col gap-2" aria-label="Image indicators">
      {Array.from({ length: totalImages }).map((_, i) => (
        <div
          class="gallery-dot w-2 h-2 rounded-2xl bg-white/40 transition-colors duration-300"
          data-dot-index={i}
        />
      ))}
    </div>

    <!-- Prev / Next navigation (CSS-only via labels + :has) -->
    {totalImages > 1 && Array.from({ length: totalImages }).map((_, i) => (
      <div
        class="gallery-nav-group absolute inset-0 flex items-center justify-between md:flex-col md:justify-between px-3 md:px-0 md:py-4 z-20 pointer-events-none"
        data-nav-for={i}
      >
        {i > 0 && (
          <label
            for={`${galleryId}-${i - 1}`}
            class="gallery-nav-btn pointer-events-auto p-3 md:p-2 flex items-center justify-center text-white cursor-pointer"
            aria-label="Previous image"
          >
            <span class="icon-[ic--outline-chevron-left] md:hidden text-2xl" aria-hidden="true"></span>
            <span class="icon-[ic--outline-expand-less] hidden md:block text-6xl" aria-hidden="true"></span>
          </label>
        )}
        {i < totalImages - 1 && (
          <label
            for={`${galleryId}-${i + 1}`}
            class="gallery-nav-btn pointer-events-auto p-3 md:p-2 flex items-center justify-center text-white cursor-pointer ml-auto md:ml-0 md:mt-auto"
            aria-label="Next image"
          >
            <span class="icon-[ic--outline-chevron-right] md:hidden text-2xl" aria-hidden="true"></span>
            <span class="icon-[ic--outline-expand-more] hidden md:block text-6xl" aria-hidden="true"></span>
          </label>
        )}
      </div>
    ))}
  </section>

  <!-- Details column -->
  <section class="details relative w-full md:w-1/2 flex-1 md:h-full overflow-y-auto px-6 pt-6 pb-6 md:px-12 md:py-12 md:pt-20 bg-canvas">
    <header class="max-w-xl mx-auto md:mx-0">
      <h1 class="text-2xl md:text-5xl lg:text-6xl font-display font-medium tracking-tight text-primary mb-2">
        {name}
      </h1>
      <p class="text-sm md:text-base text-muted font-code uppercase tracking-wider">
        {role ?? type}
      </p>
    </header>

    <div class="mt-6 md:mt-10 max-w-xl mx-auto md:mx-0">
      <p class="gallery-desc text-base text-secondary leading-relaxed line-clamp-1 md:line-clamp-none" data-desc>
        {long_description ?? description}
      </p>
      <button
        class="gallery-desc-toggle md:hidden mt-1 text-sm text-accent hover:text-accent-hover font-medium cursor-pointer"
        data-desc-toggle
        data-read-more={t('detail.readMore')}
        data-read-less={t('detail.readLess')}
        aria-expanded="false"
      >
        {t('detail.readMore')}
      </button>
    </div>

    {colaborators.length > 0 && (
      <div class="mt-6 md:mt-10 max-w-xl mx-auto md:mx-0">
        <h2 class="text-lg md:text-xl font-display font-medium text-primary mb-2">
          {t('detail.colaborators')}
        </h2>
        <p class="text-sm md:text-base text-secondary leading-relaxed">
          {collaboratorText}
        </p>
      </div>
    )}

    <!-- Tecnologías + acciones -->
    <div class="mt-6 md:mt-10 max-w-xl mx-auto md:mx-0">
      <h2 class="text-lg md:text-xl font-display font-medium text-primary mb-4">
        {t('detail.technologies')}
      </h2>
      <div class="flex flex-wrap gap-2">
        {technologies.map((tech) => (
          <span class="inline-flex items-center rounded-md px-2.5 py-1 bg-elevated text-primary font-code text-xs font-medium border border-border">
            {tech}
          </span>
        ))}
      </div>

      <!-- Action buttons (Demo / Back-end / Front-end) -->
      <div class="flex flex-wrap gap-3 mt-6 mb-12">
        {demo && (
          <a
            href={demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-canvas text-primary border border-border hover:bg-elevated focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-500 ease-spatial text-sm"
          >
            <span class="icon-[ic--outline-play-circle] text-lg" aria-hidden="true"></span>
            <span>{t('detail.demo')}</span>
          </a>
        )}
        {back_repo && (
          <a
            href={back_repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-canvas text-primary border border-border hover:bg-elevated focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-500 ease-spatial text-sm"
          >
            <span class="icon-[ic--outline-code] text-lg" aria-hidden="true"></span>
            <span>{t('detail.backend')}</span>
          </a>
        )}
        {front_repo && (
          <a
            href={front_repo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-canvas text-primary border border-border hover:bg-elevated focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-500 ease-spatial text-sm"
          >
            <span class="icon-[ic--outline-code] text-lg" aria-hidden="true"></span>
            <span>{t('detail.frontend')}</span>
          </a>
        )}
        {!back_repo && !front_repo && (
          <a
            href={repository}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-canvas text-primary border border-border hover:bg-elevated focus:outline-none focus:ring-2 focus:ring-offset-2 transition-colors duration-500 ease-spatial text-sm"
          >
            <span class="icon-[ic--outline-code] text-lg" aria-hidden="true"></span>
            <span>Repository</span>
          </a>
        )}
      </div>
    </div>
  </section>
</div>

<style set:html={`
  .project-gallery [data-gallery-input] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 1px;
    height: 1px;
  }
  .gallery-nav-group {
    display: none;
  }
  .gallery-nav-group label.gallery-nav-btn {
    color: white;
    mix-blend-mode: difference;
    opacity: 0.35;
    transition: opacity var(--duration-base) var(--ease-spatial);
  }
  .gallery-nav-group label.gallery-nav-btn:hover {
    opacity: 1;
  }
  @media (min-width: 768px) {
    .gallery-nav-group label.gallery-nav-btn {
      opacity: 0;
    }
    .gallery-nav-group:hover label.gallery-nav-btn {
      opacity: 0.6;
    }
    .gallery-nav-group label.gallery-nav-btn:hover {
      opacity: 1;
    }
  }
  .gallery-track {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  @media (min-width: 768px) {
    .gallery-track {
      scroll-snap-type: y mandatory;
    }
  }
  .gallery-slide {
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .overscroll-x-contain {
    overscroll-behavior-x: contain;
  }
  .overscroll-y-contain {
    overscroll-behavior-y: contain;
  }
  ${images.map((_, i) => `
    .project-gallery:has([data-gallery-input][data-index='${i}']:checked) [data-dot-index='${i}'] {
      background-color: white;
    }
    .project-gallery:has([data-gallery-input][data-index='${i}']:checked) .gallery-nav-group[data-nav-for='${i}'] {
      display: flex;
    }
  `).join('\n')}
`} />

<script>
  const isDesktop = () => window.innerWidth >= 768;

  function initGalleryScroll() {
    const galleries = document.querySelectorAll<HTMLElement>('.project-gallery');
    galleries.forEach((gallery) => {
      if ((gallery as any).dataset.scrollReady === '1') return;
      (gallery as any).dataset.scrollReady = '1';

      const track = gallery.querySelector<HTMLElement>('.gallery-track');
      const inputs = gallery.querySelectorAll<HTMLInputElement>('[data-gallery-input]');
      if (!track || inputs.length < 2) return;

      let isProgrammaticScroll = false;

      let wheelTimeout: ReturnType<typeof setTimeout> | null = null;
      track.addEventListener('wheel', (e: WheelEvent) => {
        e.preventDefault();

        if (wheelTimeout) return;
        wheelTimeout = setTimeout(() => {
          wheelTimeout = null;
        }, 350);

        const dir = e.deltaY > 0 ? 1 : -1;
        const size = isDesktop() ? track.clientHeight : track.clientWidth;
        const key = isDesktop() ? 'top' : 'left';
        track.scrollBy({ [key]: dir * size, behavior: 'smooth' } as ScrollToOptions);
      }, { passive: false });

      let scrollTimeout: ReturnType<typeof setTimeout>;
      track.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        if (isProgrammaticScroll) return;
        scrollTimeout = setTimeout(() => {
          const scrollPos = isDesktop() ? track.scrollTop : track.scrollLeft;
          const itemSize = isDesktop() ? track.clientHeight : track.clientWidth;
          const idx = Math.round(scrollPos / itemSize);
          const clamped = Math.max(0, Math.min(idx, inputs.length - 1));
          if (!inputs[clamped].checked) {
            inputs[clamped].checked = true;
          }
        }, 80);
      }, { passive: true });

      inputs.forEach((input, i) => {
        input.addEventListener('change', () => {
          if (input.checked) {
            isProgrammaticScroll = true;
            const size = isDesktop() ? track.clientHeight : track.clientWidth;
            const key = isDesktop() ? 'top' : 'left';
            track.scrollTo({ [key]: i * size, behavior: 'smooth' } as ScrollToOptions);
            setTimeout(() => {
              isProgrammaticScroll = false;
            }, 500);
          }
        });
      });
    });
  }

  function initReadMore() {
    const toggles = document.querySelectorAll<HTMLElement>('[data-desc-toggle]');
    toggles.forEach((toggle) => {
      if (toggle.dataset.ready === '1') return;
      toggle.dataset.ready = '1';

      const desc = toggle.previousElementSibling as HTMLElement | null;
      if (!desc) return;

      const readMoreText = toggle.dataset.readMore ?? 'Leer más';
      const readLessText = toggle.dataset.readLess ?? 'Leer menos';

      toggle.addEventListener('click', () => {
        const expanded = desc.classList.toggle('line-clamp-none');
        toggle.textContent = expanded ? readLessText : readMoreText;
        toggle.setAttribute('aria-expanded', String(expanded));
      });
    });
  }

  document.addEventListener('astro:page-load', () => {
    initGalleryScroll();
    initReadMore();
  });

  document.addEventListener('astro:before-swap', () => {
    const detail = document.querySelector<HTMLElement>('.project-detail-page[data-project-slug]');
    const slug = detail?.dataset.projectSlug;
    if (slug) {
      try { sessionStorage.setItem('lastProjectSlug', slug); } catch {}
    }
  });

  window.addEventListener('pagehide', () => {
    const detail = document.querySelector<HTMLElement>('.project-detail-page[data-project-slug]');
    const slug = detail?.dataset.projectSlug;
    if (slug) {
      try { sessionStorage.setItem('lastProjectSlug', slug); } catch {}
    }
  });
</script>
