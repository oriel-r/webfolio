---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const experienceEntries = await getCollection('experience');

const MONTH_ORDER: Record<string, number> = {
  enero: 1, january: 1, jan: 1,
  febrero: 2, february: 2, feb: 2,
  marzo: 3, march: 3, mar: 3,
  abril: 4, april: 4, apr: 4,
  mayo: 5, may: 5,
  junio: 6, june: 6, jun: 6,
  julio: 7, july: 7, jul: 7,
  agosto: 8, august: 8, aug: 8,
  septiembre: 9, september: 9, sep: 9,
  octubre: 10, october: 10, oct: 10,
  noviembre: 11, november: 11, nov: 11,
  diciembre: 12, december: 12, dec: 12,
};

function parseDateScore(dateStr?: string): number {
  if (!dateStr) return 0;
  const parts = dateStr.trim().toLowerCase().split(/\s+/);
  if (parts.length >= 2) {
    const month = MONTH_ORDER[parts[0]] ?? 0;
    const year = parseInt(parts[1], 10) || 0;
    return year * 100 + month;
  }
  const year = parseInt(dateStr, 10);
  return isNaN(year) ? 0 : year * 100;
}

const experience = experienceEntries
  .map((entry) => ({
    id: entry.id,
    ...entry.data[lang] || entry.data['es'],
  }))
  .sort((a, b) => parseDateScore(b.start_date) - parseDateScore(a.start_date));
---

<section id="experience" class="w-full md:min-w-[100vw] min-h-screen flex items-start md:items-center justify-center shrink-0 snap-start px-8 md:px-24 pt-20 md:pt-0 pb-28 md:pb-0">
  <!-- Desktop: Horizontal timeline -->
  <div class="hidden md:flex relative w-full max-w-[1664px] mx-auto h-[560px] items-center">
    <!-- Horizontal line -->
    <div class="absolute left-0 right-0 h-0.5 bg-border z-0"></div>

    <!-- Timeline items -->
    <div class="relative z-10 w-full flex justify-between items-center px-12">
      {experience.map((exp, i) => (
        <div class="relative flex justify-center">
          {i % 2 === 0 ? (
            <>
              <span class="absolute bottom-4 text-sm font-medium text-secondary whitespace-nowrap mb-2">{exp.start_date}</span>
              <div class="w-2.5 h-2.5 bg-accent rounded-full ring-4 ring-canvas"></div>
              <div class="exp-card absolute top-6 mt-4 w-72 h-52 bg-surface rounded-[32px] shadow-layer-2 border border-border p-5 flex flex-col" data-exp-slug={exp.id}>
                <div>
                  <p class="text-sm font-medium text-secondary">{exp.position}</p>
                  <p class="text-base font-semibold text-primary mt-1">{exp.company_name}</p>
                  {exp.short_description && (
                    <p class="text-sm text-secondary leading-snug mt-2">{exp.short_description}</p>
                  )}
                </div>
              </div>
            </>
          ) : (
            <>
              <div class="exp-card absolute bottom-6 mb-4 w-72 h-52 bg-surface rounded-[32px] shadow-layer-2 border border-border p-5 flex flex-col" data-exp-slug={exp.id}>
                <div>
                  <p class="text-sm font-medium text-secondary">{exp.position}</p>
                  <p class="text-base font-semibold text-primary mt-1">{exp.company_name}</p>
                  {exp.short_description && (
                    <p class="text-sm text-secondary leading-snug mt-2">{exp.short_description}</p>
                  )}
                </div>
              </div>
              <div class="w-2.5 h-2.5 bg-accent rounded-full ring-4 ring-canvas"></div>
              <span class="absolute top-4 text-sm font-medium text-secondary whitespace-nowrap mt-2">{exp.start_date}</span>
            </>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Mobile: Vertical timeline -->
  <div class="md:hidden relative w-full max-w-[1664px] mx-auto">
    <!-- Vertical line -->
    <div class="absolute left-[12px] top-0 bottom-0 w-0.5 bg-border z-0"></div>

    <!-- Timeline items -->
    <div class="relative z-10 flex flex-col gap-10">
      {experience.map((exp) => (
        <div class="flex items-start">
          <!-- Dot area -->
          <div class="w-6 shrink-0 flex justify-center pt-1.5">
            <div class="w-2.5 h-2.5 bg-accent rounded-full ring-4 ring-canvas z-10"></div>
          </div>

          <!-- Card -->
          <div class="exp-card flex-1 bg-surface rounded-[32px] shadow-layer-2 border border-border p-5 flex flex-col" data-exp-slug={exp.id}>
            <div>
              <span class="text-sm font-medium text-secondary">{exp.start_date}</span>
              <p class="text-sm font-medium text-secondary mt-2">{exp.position}</p>
              <p class="text-base font-semibold text-primary mt-1">{exp.company_name}</p>
              {exp.short_description && (
                <p class="text-sm text-secondary leading-snug mt-2">{exp.short_description}</p>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Resaltado temporal al enlazar desde Tecnologías — mismo pulso que
     tech-link-pulse en Projects, pero sin abrir detalle: solo resalta. */
  @keyframes exp-link-pulse {
    0% {
      box-shadow: var(--shadow-layer-2);
      border-color: transparent;
      transform: scale(1);
    }
    45% {
      box-shadow:
        var(--shadow-layer-2-hover),
        0 0 0 2px var(--accent),
        0 12px 36px -8px rgba(0, 173, 255, 0.38);
      border-color: var(--accent);
      transform: scale(1.03);
    }
    100% {
      box-shadow: var(--shadow-layer-2);
      border-color: transparent;
      transform: scale(1);
    }
  }

  .exp-card.exp-link-highlight {
    animation: exp-link-pulse 720ms var(--ease-hover);
    z-index: 5;
  }
</style>

<script>
  function cssEscape(value: string): string {
    return window.CSS ? window.CSS.escape(value) : value;
  }

  // Enlace desde Tecnologías: centra la card de la experiencia y la resalta.
  // No hay detalle que abrir: el pulso es solo feedback visual.
  function focusExpCardBySlug(slug: string) {
    const card = document.querySelector<HTMLElement>(
      `[data-exp-slug="${cssEscape(slug)}"]`,
    );
    if (!card) return;

    card.scrollIntoView({
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ? 'auto'
        : 'smooth',
      block: 'center',
      inline: 'center',
    });

    const holdMs = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ? 0
      : 720;
    window.setTimeout(() => {
      card.classList.add('exp-link-highlight');
      window.setTimeout(() => card.classList.remove('exp-link-highlight'), holdMs);
    }, 300);
  }

  if (!(window as any).__expFocusCardBound) {
    (window as any).__expFocusCardBound = true;
    window.addEventListener(
      'experience:focusCard',
      ((e: CustomEvent) => {
        if (e.detail?.slug) focusExpCardBySlug(e.detail.slug);
      }) as EventListener,
    );
  }
</script>
