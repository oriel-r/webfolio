---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import Tag from '../ui/Tag.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allSkills = await getCollection('skills');
const skillsByCategory = (category) =>
  allSkills
    .filter((entry) => entry.data.category === category)
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
    .map((entry) => ({
      name: entry.data.name,
      icon: entry.data.icon,
      category: entry.data.category,
      order: entry.data.order,
      projects: entry.data.projects,
      experience: entry.data.experience,
      id: entry.id,
    }));

const columns = [
  {
    grow: 'md:flex-[2]',
    cards: [
      { titleKey: 'technologies.backend', category: 'Backend & Architecture', cardGrow: 'flex-1', tagSize: 'lg', titleSize: 'lg' }
    ]
  },
  {
    grow: 'md:flex-[1.5]',
    cards: [
      { titleKey: 'technologies.devops', category: 'DevOps & Cloud', cardGrow: 'flex-[2]', tagSize: 'sm', titleSize: 'md' },
      { titleKey: 'technologies.ai', category: 'AI & Automations', cardGrow: 'flex-1', tagSize: 'sm', titleSize: 'sm' }
    ]
  },
  {
    grow: 'md:flex-[1]',
    cards: [
      { titleKey: 'technologies.frontend', category: 'Frontend', cardGrow: 'flex-1', tagSize: 'sm', titleSize: 'sm' },
      { titleKey: 'technologies.databases', category: 'Databases', cardGrow: 'flex-1', tagSize: 'sm', titleSize: 'sm' }
    ]
  }
];

let cardCounter = 0;
---

<section id="technologies" class="w-full md:min-w-[100vw] min-h-screen h-auto flex items-start justify-center shrink-0 snap-start px-4 md:px-8 lg:px-12 xl:px-24 pt-20 md:pt-24 pb-8 md:pb-28">
  <div class="flex flex-col md:flex-row md:items-stretch gap-4 md:gap-4 lg:gap-6 xl:gap-8 w-full max-w-[1664px] mx-auto h-auto md:h-full md:min-h-[300px] lg:min-h-[400px] lg:aspect-[1664/760]">
    {columns.map((col) => (
      <div class:list={[
        'flex min-w-0 flex-col gap-4 md:gap-4 lg:gap-6 xl:gap-8',
        col.grow
      ]}>
        {col.cards.map((card) => {
          const cardId = `tech-card-${cardCounter++}`;
          const skills = skillsByCategory(card.category);
          const sizeClasses = card.tagSize === 'lg'
            ? 'md:px-3 md:py-1.5 md:text-base lg:px-3.5 lg:py-2 lg:text-lg xl:px-6 xl:py-3 xl:text-xl'
            : 'md:px-2.5 md:py-1.5 md:text-sm lg:px-3.5 lg:py-2 lg:text-base xl:px-5 xl:py-2.5 xl:text-lg';
          return (
          <div
            class:list={[
              'flex flex-col p-4 md:p-4 lg:p-5 xl:p-6 rounded-2xl lg:rounded-[32px] bg-elevated border border-border min-w-0 shadow-bento hover:shadow-bento-glow transition duration-glow ease-glow will-change-transform isolate',
              card.cardGrow
            ]}
            style={`view-transition-name: card-${cardId};`}
          >
            <h3 class:list={[
              'font-semibold text-primary font-display',
              card.titleSize === 'lg'
                ? 'text-base md:text-2xl lg:text-4xl xl:text-5xl 2xl:text-6xl mb-3 md:mb-7 lg:mb-9 xl:mb-10'
                : card.titleSize === 'md'
                  ? 'text-base md:text-xl lg:text-3xl xl:text-4xl 2xl:text-4xl mb-3 md:mb-5 lg:mb-7'
                  : 'text-base md:text-lg lg:text-xl xl:text-3xl mb-3 md:mb-4 lg:mb-5 xl:mb-6'
            ]}>{t(card.titleKey)}</h3>
            <div
              class="skills-list flex flex-wrap gap-1 md:gap-1 lg:gap-1.5 xl:gap-2"
              id={cardId}
              data-skills-list
              data-skill-count={skills.length}
            >
              {skills.map((skill, i) => (
                <Tag
                  icon={skill.icon}
                  linkToProjects={skill.projects}
                  linkToExperience={skill.experience}
                  ariaLabel={
                    skill.projects?.length
                      ? `Ver proyecto ${skill.projects[0]} en Projects`
                      : skill.experience?.length
                        ? `Ver experiencia ${skill.experience[0]} en Experience`
                        : undefined
                  }
                  data-skill-index={i}
                  style={`view-transition-name: skill-${cardId}-${i};`}
                  class:list={[
                    sizeClasses,
                    i >= 3 ? 'skills-extra' : ''
                  ]}
                >
                  {skill.name}
                </Tag>
              ))}
              {skills.length > 3 && (
                <Tag
                  interactive
                  class:list={['skills-toggle md:hidden', sizeClasses]}
                  data-skills-toggle
                  aria-expanded="false"
                  aria-controls={cardId}
                  style={`view-transition-name: toggle-${cardId};`}
                  data-see-more={'\u2026' + t('technologies.seeMore')}
                  data-see-less={'\u2026' + t('technologies.seeLess')}
                >
                  <span class="skills-toggle-label">{'\u2026' + t('technologies.seeMore')}</span>
                </Tag>
              )}
            </div>
          </div>
          );
        })}
      </div>
    ))}
  </div>
</section>

<!-- Safelist for dynamically generated iconify classes used above -->
<div
  class="hidden icon-[simple-icons--nodedotjs] icon-[simple-icons--typescript] icon-[simple-icons--nestjs] icon-[simple-icons--express] icon-[simple-icons--hono] icon-[simple-icons--swagger] icon-[simple-icons--jsonwebtokens] icon-[simple-icons--betterauth] icon-[simple-icons--docker] icon-[simple-icons--linux] icon-[simple-icons--googlecloud] icon-[simple-icons--amazonwebservices] icon-[simple-icons--githubactions] icon-[simple-icons--render] icon-[simple-icons--react] icon-[simple-icons--astro] icon-[simple-icons--tailwindcss] icon-[simple-icons--redux] icon-[simple-icons--postgresql] icon-[simple-icons--redis] icon-[simple-icons--sqlite] icon-[simple-icons--typeorm] icon-[simple-icons--prisma] icon-[simple-icons--mongodb] icon-[simple-icons--googlegemini] icon-[simple-icons--figma] icon-[simple-icons--javascript] icon-[simple-icons--mongoose]"
  aria-hidden="true"
></div>

<style>
  /* Mobile colapsado: oculta pills 3+ con display:none !important
     (necesario para pisar .inline-flex del baseStyles de Tag, que
     por cascada gana sobre .hidden de Tailwind). Scoped a <768px:
     con ambas reglas !important, :not(.is-expanded) da mayor
     especificidad y ganaba también en desktop. */
  @media (max-width: 767px) {
    .skills-list:not(.is-expanded) > :global([data-skill-index].skills-extra) {
      display: none !important;
    }
  }

  /* En desktop, las pills 3+ siempre visibles */
  @media (min-width: 768px) {
    .skills-list > :global([data-skill-index].skills-extra) {
      display: inline-flex !important;
    }
    .skills-toggle {
      display: none !important;
    }
  }

  /* Una sección expandida necesita scroll libre hasta su final. */
  @media (max-width: 767px) {
    :global(#scroll-container.has-expanded-technologies) {
      scroll-snap-type: y proximity;
    }
  }

  /* Mantener suaves las transiciones visuales de las cards y pills */
  ::view-transition-group(*) {
    animation-duration: 300ms;
    animation-timing-function: cubic-bezier(0.25, 1, 0.5, 1);
  }
</style>

<script is:inline>
  (function () {
    function update() {
      var el = document.getElementById('technologies');
      if (!el) return;
      var w = window.innerWidth;
      var portrait = window.matchMedia('(orientation: portrait)').matches;
      el.classList.toggle('is-portrait-tablet', w >= 768 && w <= 1023 && portrait);
    }
    update();
    window.addEventListener('resize', update);
    window.addEventListener('orientationchange', update);
  })();
</script>

<script>
  function getSectionIndex(id: string, fallback: number): number {
    const container = document.getElementById('scroll-container');
    if (!container) return fallback;
    const sections = Array.from(container.querySelectorAll('section'));
    const idx = sections.findIndex((s) => s.id === id);
    return idx >= 0 ? idx : fallback;
  }

  function isOnSection(id: string): boolean {
    return window.location.hash.replace('#', '') === id;
  }

  interface TechLinkTarget {
    sectionIndex: number;
    sectionId: string;
    eventName: string;
    slug: string;
  }

  function resolveTarget(el: HTMLElement): TechLinkTarget | null {
    const projectsRaw = el.getAttribute('data-tech-projects');
    const experienceRaw = el.getAttribute('data-tech-experience');
    const slug = (projectsRaw ?? experienceRaw ?? '')
      .split(',')[0]
      .trim();
    if (!slug) return null;

    if (projectsRaw) {
      return {
        sectionIndex: getSectionIndex('projects', 2),
        sectionId: 'projects',
        eventName: 'projects:focusCard',
        slug,
      };
    }
    return {
      sectionIndex: getSectionIndex('experience', 1),
      sectionId: 'experience',
      eventName: 'experience:focusCard',
      slug,
    };
  }

  function onTechClick(e: Event) {
    const el = e.currentTarget as HTMLElement;
    const target = resolveTarget(el);
    if (!target) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Ya estamos en la sección destino: resaltar directo.
    if (isOnSection(target.sectionId)) {
      window.dispatchEvent(
        new CustomEvent(target.eventName, { detail: { slug: target.slug } }),
      );
      return;
    }

    // 1. Scroll animado a la sección (scroll.ts escucha `navClick`).
    window.dispatchEvent(
      new CustomEvent('navClick', { detail: { index: target.sectionIndex } }),
    );

    // 2. Tras el asentamiento del snap de sección (lock ~800ms en scroll.ts),
    //    resaltar la card destino.
    window.setTimeout(
      () =>
        window.dispatchEvent(
          new CustomEvent(target.eventName, { detail: { slug: target.slug } }),
        ),
      reduced ? 60 : 480,
    );
  }

  function initTechLinks() {
    const tags = document.querySelectorAll('[data-tech-projects], [data-tech-experience]');
    if (!tags.length) return;
    tags.forEach((tag) => {
      tag.addEventListener('click', onTechClick);
    });
  }

  initTechLinks();
  document.addEventListener('astro:after-swap', initTechLinks);
</script>

<script>
  // Colapso de pills en mobile sin navegación ni transición de documento.
  // El cambio directo de clase permite que el layout de la sección crezca
  // naturalmente sin animar ni reemplazar el documento completo.
  function initSkillCollapse() {
    function syncExpandedSnap() {
      const scrollContainer = document.getElementById('scroll-container');
      const hasExpandedSkills = Boolean(
        document.querySelector('#technologies .skills-list.is-expanded'),
      );
      scrollContainer?.classList.toggle(
        'has-expanded-technologies',
        hasExpandedSkills,
      );
    }

    document.querySelectorAll<HTMLElement>('.skills-list').forEach((list) => {
      if (list.dataset.ready === '1') return;
      list.dataset.ready = '1';

      const toggle = list.querySelector<HTMLButtonElement>('[data-skills-toggle]');
      const label = toggle?.querySelector<HTMLElement>('.skills-toggle-label');
      if (!toggle || !label) return;

      toggle.addEventListener('click', (event) => {
        event.preventDefault();
        const isExpanded = list.classList.contains('is-expanded');

        if (isExpanded) {
          list.classList.remove('is-expanded');
          toggle.setAttribute('aria-expanded', 'false');
          if (label) label.textContent = toggle.dataset.seeMore ?? '…Ver más';
        } else {
          list.classList.add('is-expanded');
          toggle.setAttribute('aria-expanded', 'true');
          if (label) label.textContent = toggle.dataset.seeLess ?? '…Ver menos';
        }

        syncExpandedSnap();
      });
    });

    syncExpandedSnap();
  }

  document.addEventListener('astro:after-swap', initSkillCollapse);
  initSkillCollapse();
</script>
