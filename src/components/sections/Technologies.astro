---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import Tag from '../ui/Tag.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allSkills = await getCollection('skills');
const skillsByCategory = (category) =>
  allSkills
    .filter((entry) => entry.data.category === category)
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
    .map((entry) => ({
      name: entry.data.name,
      icon: entry.data.icon,
      category: entry.data.category,
      order: entry.data.order,
      projects: entry.data.projects,
      id: entry.id,
    }));

const columns = [
  {
    grow: 'md:flex-[2]',
    cards: [
      { titleKey: 'technologies.backend', category: 'Backend & Architecture', cardGrow: 'flex-1', tagSize: 'lg', titleSize: 'lg' }
    ]
  },
  {
    grow: 'md:flex-[1.5]',
    cards: [
      { titleKey: 'technologies.devops', category: 'DevOps & Cloud', cardGrow: 'flex-[2]', tagSize: 'sm', titleSize: 'md' },
      { titleKey: 'technologies.ai', category: 'AI & Automations', cardGrow: 'flex-1', tagSize: 'sm', titleSize: 'sm' }
    ]
  },
  {
    grow: 'md:flex-[1]',
    cards: [
      { titleKey: 'technologies.frontend', category: 'Frontend', cardGrow: 'flex-1', tagSize: 'sm', titleSize: 'sm' },
      { titleKey: 'technologies.databases', category: 'Databases', cardGrow: 'flex-1', tagSize: 'sm', titleSize: 'sm' }
    ]
  }
];
---

<section id="technologies" class="w-full md:min-w-[100vw] min-h-screen flex items-start justify-center shrink-0 snap-start px-4 md:px-8 lg:px-12 xl:px-24 pt-20 md:pt-24 pb-8 md:pb-28">
  <div class="flex flex-col md:flex-row md:items-stretch gap-4 md:gap-4 lg:gap-6 xl:gap-8 w-full max-w-[1664px] mx-auto h-full md:min-h-[300px] lg:min-h-[400px] lg:aspect-[1664/760]">
    {columns.map((col) => (
      <div class:list={[
        'flex min-w-0 flex-col gap-4 md:gap-4 lg:gap-6 xl:gap-8',
        col.grow
      ]}>
        {col.cards.map((card) => (
          <div class:list={[
            'flex flex-col p-4 md:p-4 lg:p-5 xl:p-6 rounded-2xl lg:rounded-[32px] bg-elevated border border-border min-w-0 shadow-bento hover:shadow-bento-glow transition duration-glow ease-glow will-change-transform isolate',
            card.cardGrow
          ]}>
            <h3 class:list={[
              'font-semibold text-primary font-display',
              card.titleSize === 'lg'
                ? 'text-base md:text-2xl lg:text-4xl xl:text-5xl 2xl:text-6xl mb-3 md:mb-7 lg:mb-9 xl:mb-10'
                : card.titleSize === 'md'
                  ? 'text-base md:text-xl lg:text-3xl xl:text-4xl 2xl:text-4xl mb-3 md:mb-5 lg:mb-7'
                  : 'text-base md:text-lg lg:text-xl xl:text-3xl mb-3 md:mb-4 lg:mb-5 xl:mb-6'
            ]}>{t(card.titleKey)}</h3>
            <div class="flex flex-wrap gap-1 md:gap-1 lg:gap-1.5 xl:gap-2">
              {skillsByCategory(card.category).map((skill) => (
                <Tag
                  icon={skill.icon}
                  linkToProjects={skill.projects}
                  ariaLabel={skill.projects?.length ? `Ver proyecto ${skill.projects[0]} en Projects` : undefined}
                  class:list={[
                    card.tagSize === 'lg'
                      ? 'md:px-3 md:py-1.5 md:text-base lg:px-3.5 lg:py-2 lg:text-lg xl:px-6 xl:py-3 xl:text-xl'
                      : 'md:px-2.5 md:py-1.5 md:text-sm lg:px-3.5 lg:py-2 lg:text-base xl:px-5 xl:py-2.5 xl:text-lg'
                  ]}
                >
                  {skill.name}
                </Tag>
              ))}
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<!-- Safelist for dynamically generated iconify classes used above -->
<div
  class="hidden icon-[simple-icons--nodedotjs] icon-[simple-icons--typescript] icon-[simple-icons--nestjs] icon-[simple-icons--express] icon-[simple-icons--hono] icon-[simple-icons--swagger] icon-[simple-icons--jsonwebtokens] icon-[simple-icons--betterauth] icon-[simple-icons--docker] icon-[simple-icons--linux] icon-[simple-icons--googlecloud] icon-[simple-icons--amazonwebservices] icon-[simple-icons--githubactions] icon-[simple-icons--render] icon-[simple-icons--react] icon-[simple-icons--astro] icon-[simple-icons--tailwindcss] icon-[simple-icons--redux] icon-[simple-icons--postgresql] icon-[simple-icons--redis] icon-[simple-icons--sqlite] icon-[simple-icons--typeorm] icon-[simple-icons--prisma] icon-[simple-icons--mongodb] icon-[simple-icons--googlegemini]"
  aria-hidden="true"
></div>

<style>
  :global(.dark) #technologies > div:first-child {
    position: relative;
  }

  :global(.dark) #technologies > div:first-child::before {
    content: '';
    position: absolute;
    inset: -12%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(255, 180, 110, 0.12), transparent 80%);
  }
</style>

<script is:inline>
  (function () {
    function update() {
      var el = document.getElementById('technologies');
      if (!el) return;
      var w = window.innerWidth;
      var portrait = window.matchMedia('(orientation: portrait)').matches;
      el.classList.toggle('is-portrait-tablet', w >= 768 && w <= 1023 && portrait);
    }
    update();
    window.addEventListener('resize', update);
    window.addEventListener('orientationchange', update);
  })();
</script>

<script>
  function getProjectsSectionIndex(): number {
    const container = document.getElementById('scroll-container');
    if (!container) return 2;
    const sections = Array.from(container.querySelectorAll('section'));
    const idx = sections.findIndex((s) => s.id === 'projects');
    return idx >= 0 ? idx : 2;
  }

  function isOnProjects(): boolean {
    return window.location.hash.replace('#', '') === 'projects';
  }

  function focusCard(slug: string) {
    window.dispatchEvent(
      new CustomEvent('projects:focusCard', { detail: { slug } }),
    );
  }

  function onTechClick(e: Event) {
    const el = e.currentTarget as HTMLElement;
    const raw = el.getAttribute('data-tech-projects');
    if (!raw) return;
    const slugs = raw
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    const slug = slugs[0];
    if (!slug) return;

    const projectsIndex = getProjectsSectionIndex();
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Ya estamos en Projects: ir directo a centrar la card + abrir.
    if (isOnProjects()) {
      focusCard(slug);
      return;
    }

    // 1. Scroll animado a la sección Projects (scroll.ts escucha `navClick`).
    window.dispatchEvent(
      new CustomEvent('navClick', { detail: { index: projectsIndex } }),
    );

    // 2. Tras el asentamiento del snap de sección (lock ~800ms en scroll.ts),
    //    centrar la card en el carrusel y abrirla.
    window.setTimeout(() => focusCard(slug), reduced ? 60 : 480);
  }

  function initTechLinks() {
    const tags = document.querySelectorAll('[data-tech-projects]');
    if (!tags.length) return;
    tags.forEach((tag) => {
      tag.addEventListener('click', onTechClick);
    });
  }

  initTechLinks();
  document.addEventListener('astro:after-swap', initTechLinks);
</script>
