---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="w-full md:min-w-[100vw] min-h-screen flex items-start md:items-center justify-center shrink-0 snap-start px-8 md:px-24">
  <div class="flex flex-col md:flex-row items-center justify-between w-full max-w-7xl mx-auto gap-12 pt-20 md:pt-24">

    <!-- Text Content -->
    <div class="w-full md:w-1/2 space-y-6">
      <h2 class="text-4xl md:text-5xl font-medium tracking-tight text-primary max-w-md leading-tight font-display">
        {t('contact.title')}
      </h2>
      <div class="text-base text-secondary max-w-sm leading-relaxed space-y-4">
        <p>
          {t('contact.body')}
        </p>
        <p class="font-medium text-primary">
          {t('contact.cta')}
        </p>
      </div>
    </div>

    <!-- Contact Cards -->
    <div class="w-full md:w-1/2 flex justify-center md:justify-end gap-4 md:gap-6">
      <!-- Calendar Card -->
      <a href="#" class="w-28 h-28 md:w-36 md:h-36 bg-surface rounded-2xl border border-border flex flex-col items-center justify-center gap-3 shadow-layer-2 hover:shadow-layer-2-hover transition-all duration-500 ease-spatial md:hover:scale-[1.02] will-change-transform isolate group">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent group-hover:scale-110 transition-transform"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
        <span class="text-xs font-medium text-accent text-center px-2">{t('contact.call')}</span>
      </a>

      <!-- Email Card -->
      <button class="w-28 h-28 md:w-36 md:h-36 bg-surface rounded-2xl border border-border flex flex-col items-center justify-center gap-3 shadow-layer-2 hover:shadow-layer-2-hover transition-all duration-500 ease-spatial md:hover:scale-[1.02] will-change-transform isolate group">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent group-hover:scale-110 transition-transform"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <span class="text-xs font-medium text-accent text-center px-2">{t('contact.email')}</span>
      </button>

      <!-- PDF Card -->
      <a href="/resume.pdf" class="w-28 h-28 md:w-36 md:h-36 bg-surface rounded-2xl border border-border flex flex-col items-center justify-center gap-3 shadow-layer-2 hover:shadow-layer-2-hover transition-all duration-500 ease-spatial md:hover:scale-[1.02] will-change-transform isolate group">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent group-hover:scale-110 transition-transform"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="m9 15 3 3 3-3"/></svg>
        <span class="text-xs font-medium text-accent text-center px-2">{t('contact.download')}</span>
      </a>
    </div>

  </div>
</section>
