---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import ContactPet from '../ui/ContactPet.astro';
import contactPetUrl from '../../assets/contact_pet_v2.svg?url';


const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="relative overflow-hidden w-full md:min-w-[100vw] min-h-screen flex items-start md:items-center justify-center shrink-0 snap-start px-8 md:px-24 pt-20 md:pt-0">
  <!-- Capa 2+3: Glow + ContactPet, esquina inferior derecha (mitad fuera del viewport en desktop).
       Wrapper externo hace el posicionamiento absoluto (evita conflicto con el `relative`
       interno de .contact-pet-wrap, que es contexto del glow ::after). -->
  <div class="contact-pet-anchor absolute bottom-0 right-0 z-0 w-[18rem] md:w-[34.656rem] -translate-y-12 md:translate-y-0 translate-x-[28%] md:translate-x-[25%] md:translate-y-1/4 pointer-events-none">
    <ContactPet class="w-full h-auto text-muted dark:text-brand-dominant-900" />
  </div>

  <!-- Capa 4: Contenido de la pagina (mantiene su posicion original) -->
  <div class="relative z-10 flex flex-col md:flex-row items-center justify-between w-full max-w-7xl mx-auto gap-12">

    <!-- Text Content -->
    <div class="w-full md:w-1/2 space-y-6">
      <h2 class="text-4xl md:text-5xl font-medium tracking-tight text-primary max-w-md leading-tight font-display">
        {t('contact.title')}
      </h2>
      <div class="text-base text-secondary max-w-sm leading-relaxed space-y-4">
        <p>
          {t('contact.body')}
        </p>
        <p class="font-medium text-cta">
          {t('contact.cta')}
        </p>
      </div>
    </div>

    <!-- Contact Cards -->
    <div class="w-full md:w-1/2 flex justify-center md:justify-end gap-4 md:gap-6">
      <!-- Calendar Card -->
      <a href="https://example.com" target="_blank" rel="noopener noreferrer" data-contact-card data-toast-message={t('contact.callOpened')} aria-label={t('contact.call')} class="w-28 h-28 md:w-36 md:h-36 bg-surface rounded-lg md:rounded-[32px] border border-border flex flex-col items-center justify-center gap-3 shadow-layer-2 hover:shadow-layer-2-hover transition duration-hover ease-hover md:hover:scale-[1.02] will-change-transform isolate group">
        <span class="icon-[ic--outline-calendar-month] text-[32px] text-accent group-hover:text-cta group-hover:scale-110 transition duration-hover ease-hover" aria-hidden="true"></span>
        <span class="sr-only md:not-sr-only text-xs font-medium text-accent group-hover:text-cta transition-colors duration-hover ease-hover text-center px-2">{t('contact.call')}</span>
      </a>

      <!-- Email Card -->
      <button
        id="email-copy-btn"
        type="button"
        data-contact-card
        data-email="orielromero97@gmail.com"
        data-copied-text={t('contact.copied')}
        data-copy-success={t('contact.copySuccess')}
        data-copy-error={t('contact.copyError')}
        aria-label={t('contact.email')}
        class="w-28 h-28 md:w-36 md:h-36 bg-surface rounded-lg md:rounded-[32px] border border-border flex flex-col items-center justify-center gap-3 shadow-layer-2 hover:shadow-layer-2-hover transition duration-hover ease-hover md:hover:scale-[1.02] will-change-transform isolate group cursor-pointer"
      >
        <span class="icon-[ic--outline-mail] text-[32px] text-accent group-hover:text-cta group-hover:scale-110 transition duration-hover ease-hover" aria-hidden="true"></span>
        <span class="sr-only md:not-sr-only text-xs font-medium text-accent group-hover:text-cta transition-colors duration-hover ease-hover text-center px-2" aria-live="polite">{t('contact.email')}</span>
      </button>

      <!-- PDF Card -->
      <a href={contactPetUrl} download="contact-pet.svg" data-contact-card data-toast-message={t('contact.downloadSuccess')} aria-label={t('contact.download')} class="w-28 h-28 md:w-36 md:h-36 bg-surface rounded-lg md:rounded-[32px] border border-border flex flex-col items-center justify-center gap-3 shadow-layer-2 hover:shadow-layer-2-hover transition duration-hover ease-hover md:hover:scale-[1.02] will-change-transform isolate group">
        <span class="icon-[ic--outline-file-download] text-[32px] text-accent group-hover:text-cta group-hover:scale-110 transition duration-hover ease-hover" aria-hidden="true"></span>
        <span class="sr-only md:not-sr-only text-xs font-medium text-accent group-hover:text-cta transition-colors duration-hover ease-hover text-center px-2">{t('contact.download')}</span>
      </a>
    </div>

  </div>

  <!-- Copy Toast -->
  <div
    id="contact-toast"
    role="status"
    aria-live="polite"
    aria-atomic="true"
    class="fixed bottom-24 md:bottom-16 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 px-6 py-4 bg-surface border border-border rounded-[32px] shadow-layer-2 opacity-0 translate-y-8 pointer-events-none transition-all duration-base ease-spatial"
  >
    <span class="icon-[ic--outline-check-circle] text-2xl text-cta" aria-hidden="true"></span>
    <span class="text-sm font-medium text-primary font-body" data-toast-message></span>
  </div>
</section>

<script is:inline>
  (function () {
    function initContactActionGlow() {
      const cards = document.querySelectorAll('[data-contact-card]');
      if (!cards.length) return;
      cards.forEach(function (card) {
        if (card.dataset.glowBound === '1') return;
        card.dataset.glowBound = '1';
        card.addEventListener('click', function () {
          window.dispatchEvent(new CustomEvent('contact:actionGlow'));
        });
      });
    }
    initContactActionGlow();
    document.addEventListener('astro:after-swap', initContactActionGlow);
  })();
</script>

<script is:inline>
  (function () {
    let toastTimeout = null;
    let toastDelayTimeout = null;
    const toastDelay = 350;
    const toastDuration = 2500;

    function showToast(message) {
      if (!message) return;
      const toast = document.getElementById('contact-toast');
      const toastMessage = toast && toast.querySelector('[data-toast-message]');
      if (!toast || !toastMessage) return;

      toastMessage.textContent = message;
      toast.classList.remove('opacity-0', 'translate-y-8', 'pointer-events-none');
      toast.classList.add('opacity-100', 'translate-y-0');

      if (toastTimeout) {
        clearTimeout(toastTimeout);
      }

      toastTimeout = setTimeout(function () {
        toast.classList.add('opacity-0', 'translate-y-8', 'pointer-events-none');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, toastDuration);
    }

    function scheduleToast(message) {
      if (!message) return;
      if (toastDelayTimeout) {
        clearTimeout(toastDelayTimeout);
      }

      toastDelayTimeout = setTimeout(function () {
        toastDelayTimeout = null;
        showToast(message);
      }, toastDelay);
    }

    function initContactToast() {
      const btn = document.getElementById('email-copy-btn');
      if (btn && btn.dataset.toastBound !== '1') {
        btn.dataset.toastBound = '1';

        const email = btn.dataset.email;
        const copiedText = btn.dataset.copiedText;
        const successText = btn.dataset.copySuccess;
        const errorText = btn.dataset.copyError;
        const labelSpan = btn.querySelector('span[aria-live="polite"]');
        const originalText = labelSpan ? labelSpan.textContent : '';

        btn.addEventListener('click', async function () {
          if (!email || !labelSpan) return;
          if (toastDelayTimeout) {
            clearTimeout(toastDelayTimeout);
            toastDelayTimeout = null;
          }

          try {
            await navigator.clipboard.writeText(email);
            labelSpan.textContent = copiedText || '¡Copiado!';
            scheduleToast(successText || 'Email copiado al portapapeles');

            setTimeout(function () {
              labelSpan.textContent = originalText;
            }, 2000);
          } catch (err) {
            console.error('Failed to copy email:', err);
            scheduleToast(errorText || 'No se pudo copiar el email');
          }
        });
      }

      document.querySelectorAll('[data-contact-card][data-toast-message]').forEach(function (card) {
        if (card.dataset.toastBound === '1') return;
        card.dataset.toastBound = '1';
        card.addEventListener('click', function () {
          scheduleToast(card.dataset.toastMessage);
        });
      });
    }

    initContactToast();
    document.addEventListener('astro:after-swap', initContactToast);
  })();
</script>
