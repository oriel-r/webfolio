---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';


const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="w-full md:min-w-[100vw] min-h-screen flex items-start md:items-center justify-center shrink-0 snap-start px-8 md:px-24 pt-20">
  <div class="flex flex-col md:flex-row items-center justify-between w-full max-w-7xl mx-auto gap-12 md:pt-24">

    <!-- Text Content -->
    <div class="w-full md:w-1/2 space-y-6">
      <h2 class="text-4xl md:text-5xl font-medium tracking-tight text-primary max-w-md leading-tight font-display">
        {t('contact.title')}
      </h2>
      <div class="text-base text-secondary max-w-sm leading-relaxed space-y-4">
        <p>
          {t('contact.body')}
        </p>
        <p class="font-medium text-primary">
          {t('contact.cta')}
        </p>
      </div>
    </div>

    <!-- Contact Cards -->
    <div class="w-full md:w-1/2 flex justify-center md:justify-end gap-4 md:gap-6">
      <!-- Calendar Card -->
      <a href="#" class="w-28 h-28 md:w-36 md:h-36 bg-surface rounded-[32px] border border-border flex flex-col items-center justify-center gap-3 shadow-layer-2 hover:shadow-layer-2-hover transition-all duration-500 ease-spatial md:hover:scale-[1.02] will-change-transform isolate group">
        <span class="icon-[ic--outline-calendar-month] text-[32px] text-accent group-hover:scale-110 transition-transform" aria-hidden="true"></span>
        <span class="text-xs font-medium text-accent text-center px-2">{t('contact.call')}</span>
      </a>

      <!-- Email Card -->
      <button class="w-28 h-28 md:w-36 md:h-36 bg-surface rounded-[32px] border border-border flex flex-col items-center justify-center gap-3 shadow-layer-2 hover:shadow-layer-2-hover transition-all duration-500 ease-spatial md:hover:scale-[1.02] will-change-transform isolate group">
        <span class="icon-[ic--outline-mail] text-[32px] text-accent group-hover:scale-110 transition-transform" aria-hidden="true"></span>
        <span class="text-xs font-medium text-accent text-center px-2">{t('contact.email')}</span>
      </button>

      <!-- PDF Card -->
      <a href="/resume.pdf" class="w-28 h-28 md:w-36 md:h-36 bg-surface rounded-[32px] border border-border flex flex-col items-center justify-center gap-3 shadow-layer-2 hover:shadow-layer-2-hover transition-all duration-500 ease-spatial md:hover:scale-[1.02] will-change-transform isolate group">
        <span class="icon-[ic--outline-file-download] text-[32px] text-accent group-hover:scale-110 transition-transform" aria-hidden="true"></span>
        <span class="text-xs font-medium text-accent text-center px-2">{t('contact.download')}</span>
      </a>
    </div>

  </div>
</section>
