---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getCollection } from 'astro:content';
import { getMediaThumbnails } from '../../utils/youtube';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const projectEntries = await getCollection('projects');
const projects = projectEntries.map((entry) => ({
  id: entry.id,
  ...entry.data[lang] || entry.data['es'],
}));

const thumbnails: Record<string, string | null> = Object.fromEntries(
  projects.map((p) => [p.id, getMediaThumbnails(p.media)]),
);
---

<section id="projects" class="w-full md:min-w-[100vw] min-h-screen h-auto md:h-screen flex items-start md:items-center justify-center shrink-0 snap-start px-0 pt-20 md:pt-0 py-0">
  <div class="flex flex-col md:flex-row items-center justify-center w-full h-auto md:h-full">

    <!-- Projects Carousel -->
    <div class="w-full md:w-1/2 h-auto md:h-full relative order-1 md:order-1">
      <div class="flex flex-col items-center h-auto md:h-full">
        <!-- Carousel scroll container -->
        <div
          id="projects-carousel"
          class="projects-carousel w-full h-auto md:h-full flex items-center md:items-end md:flex-col gap-8 scroll-smooth px-6 py-8 md:px-12 md:py-0"
          style="-ms-overflow-style: none; scrollbar-width: none;"
        >
          <!-- Spacer: allows first card to center (desktop: vertical, mobile: horizontal) -->
          <div class="projects-spacer flex-shrink-0 w-[calc(50vw-144px)] h-0 md:w-0 md:h-[calc(50%-144px)]" aria-hidden="true" />

          {projects.map((project) => (
            <a
              href={translatePath(`/projects/${project.id}`)}
              data-project-slug={project.id}
              aria-label={`Open project: ${project.name}`}
              class="projects-card flex-shrink-0 w-[min(85vw,288px)] md:w-[clamp(288px,30vw,578px)] aspect-square rounded-[32px] overflow-hidden relative group cursor-pointer shadow-layer-2 hover:shadow-layer-2-hover transition duration-slow ease-hover md:hover:scale-[1.02] will-change-transform isolate block"
              style={`view-transition-name: project-card-${project.id};`}
            >
              {thumbnails[project.id] ? (
                <img
                  src={thumbnails[project.id]!}
                  alt={project.name}
                  style={`view-transition-name: project-${project.id}-gallery;`}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-slow ease-hover group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="absolute inset-0 bg-elevated" />
              )}

              <div class="absolute inset-0 bg-gradient-to-t from-overlay-strong via-overlay-soft to-transparent" />

              <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
                <h3 class="text-2xl md:text-4xl font-bold text-on-image font-display mb-1">{project.name}</h3>
                <p class="text-base md:text-lg text-on-image/70">{project.type}</p>
              </div>
            </a>
          ))}

          <!-- Spacer: allows last card to center (desktop: vertical, mobile: horizontal) -->
          <div class="projects-spacer flex-shrink-0 w-[calc(50vw-144px)] h-0 md:w-0 md:h-[calc(50%-144px)]" aria-hidden="true" />
        </div>

        <!-- Indicators: fixed dots below carousel on mobile (OUTSIDE scroll container) -->
        <div id="carousel-indicators" class="flex flex-row gap-2 justify-center mt-4 md:hidden shrink-0">
          {projects.map((_: any, i: number) => (
            <div
              class:list={[
                "w-2 h-2 rounded-full transition-colors duration-base ease-spatial",
                i === 0 ? "bg-primary" : "bg-border"
              ]}
              data-index={i}
            />
          ))}
        </div>
      </div>

      <!-- Desktop indicators: right side -->
      <div id="carousel-indicators-desktop" class="hidden md:flex absolute right-[-2rem] top-1/2 -translate-y-1/2 flex-col gap-2">
        {projects.map((_: any, i: number) => (
          <div
            class:list={[
                "w-2 h-2 rounded-full transition-colors duration-base ease-spatial",
                i === 0 ? "bg-primary h-4" : "bg-border"
            ]}
            data-index={i}
          />
        ))}
      </div>
    </div>

    <!-- Text Content -->
    <div class="w-full md:w-1/2 max-w-7xl mx-auto space-y-6 shrink-0 order-2 md:order-2 flex flex-col justify-center text-left px-8 md:px-24">
      <h2 class="text-4xl md:text-5xl font-medium tracking-tight text-primary font-display">
        {t('section.projects')}
      </h2>
      <p class="text-base text-secondary max-w-md leading-relaxed">
        {t('projects.description')}
      </p>
      <p class="text-sm text-muted mt-2">
        {t('projects.cta')}
      </p>
    </div>

  </div>
</section>

<style>
  #projects-carousel::-webkit-scrollbar {
    display: none;
  }

  /* Enforce 1:1 aspect ratio on cards as a fallback */
  #projects-carousel a {
    aspect-ratio: 1 / 1;
  }

  /* Highlight temporal al enlazar desde Tecnologías — pulse suave estilo pill */
  @keyframes tech-link-pulse {
    0% {
      box-shadow: var(--shadow-layer-2);
      border-color: transparent;
      transform: scale(1);
    }
    45% {
      box-shadow:
        var(--shadow-layer-2-hover),
        0 0 0 2px var(--accent),
        0 12px 36px -8px rgba(0, 173, 255, 0.38);
      border-color: var(--accent);
      transform: scale(1.03);
    }
    100% {
      box-shadow: var(--shadow-layer-2);
      border-color: transparent;
      transform: scale(1);
    }
  }

  #projects-carousel .projects-card.tech-link-highlight {
    animation: tech-link-pulse 720ms var(--ease-hover);
    z-index: 5;
  }

  /* ===== Mobile: horizontal snap, sin inercia, tarjeta-por-tarjeta ===== */
  @media (max-width: 767px) {
    #projects-carousel {
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: auto; /* desactiva momentum/inercia iOS */
      touch-action: pan-x;              /* solo swipe horizontal */
      overscroll-behavior-x: contain;   /* no propagar scroll al body */
      scrollbar-width: none;
    }
    #projects-carousel .projects-card {
      scroll-snap-align: center;
      scroll-snap-stop: always;         /* FUERZA detener en cada card */
    }
  }

  /* ===== Desktop: scroll vertical con snap ===== */
  @media (min-width: 768px) {
    #projects-carousel {
      overflow-x: hidden;
      overflow-y: auto;
      scroll-snap-type: y mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: auto;
      touch-action: pan-y;
      overscroll-behavior-y: contain;
    }
    #projects-carousel .projects-card {
      scroll-snap-align: center;
      scroll-snap-stop: always;
    }
  }
</style>

<script>
  let focusCardBySlugRef: ((slug: string) => void) | null = null;

  window.addEventListener(
    'projects:focusCard',
    ((e: CustomEvent) => {
      if (e.detail?.slug) focusCardBySlugRef?.(e.detail.slug);
    }) as EventListener,
  );

  function cssEscape(value: string): string {
    return window.CSS ? window.CSS.escape(value) : value;
  }

  function initCarousel() {
    const carousel = document.getElementById('projects-carousel');
    if (!carousel) return;

    const mobileIndicators = document.querySelectorAll('#carousel-indicators > div');
    const desktopIndicators = document.querySelectorAll('#carousel-indicators-desktop > div');
    const cards = carousel.querySelectorAll('a');
    const totalCards = cards.length;
    let currentIndex = 0;
    let isAnimating = false;

function getCardOffset(index: number): number {
      const card = cards[index] as HTMLElement;
      if (!card) return 0;
      const isDesktop = window.innerWidth >= 768;

      if (isDesktop) {
        const cardTop = card.offsetTop;
        const containerCenter = carousel.clientHeight / 2;
        const cardCenter = card.offsetHeight / 2;
        return cardTop - containerCenter + cardCenter;
      } else {
        const cardLeft = card.offsetLeft;
        const containerCenter = carousel.clientWidth / 2;
        const cardCenter = card.offsetWidth / 2;
        return cardLeft - containerCenter + cardCenter;
      }
    }

    function centerCardByIndex(
      index: number,
      behavior: ScrollBehavior = 'smooth',
    ) {
      if (index < 0 || index >= totalCards) return;
      currentIndex = index;
      const offset = getCardOffset(index);
      const isDesktop = window.innerWidth >= 768;
      carousel.scrollTo({
        [isDesktop ? 'top' : 'left']: offset,
        behavior,
      });
      updateIndicators();
    }

    function scrollToCard(index: number) {
      if (index < 0 || index >= totalCards || isAnimating) return;
      isAnimating = true;

      centerCardByIndex(index, 'smooth');

      setTimeout(() => {
        isAnimating = false;
      }, 600);
    }

    // Enlace desde Tecnologías: centra la card del slug, resalta y abre el detail.
    // Cuando `open` es false (p. ej. al volver desde el detalle) solo centra,
    // sin disparar highlight ni click (evita reabrir el detalle en bucle).
    function focusCardBySlug(slug: string, open = true) {
      const card = carousel.querySelector<HTMLAnchorElement>(
        `a[data-project-slug="${cssEscape(slug)}"]`,
      );
      if (!card) return;
      const index = Array.from(cards).indexOf(card);
      if (index < 0) return;

      centerCardByIndex(index, 'smooth');

      if (!open) return;

      const reduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      const settleMs = reduced ? 0 : 300;
      const holdMs = reduced ? 0 : 720;

      window.setTimeout(() => {
        card.classList.add('tech-link-highlight');
        window.setTimeout(() => {
          card.classList.remove('tech-link-highlight');
          card.click();
        }, holdMs);
      }, settleMs);
    }
    focusCardBySlugRef = focusCardBySlug;

    function updateIndicators() {
      const allIndicators = [...mobileIndicators, ...desktopIndicators];
      allIndicators.forEach((ind, i) => {
        const realIndex = i % mobileIndicators.length;
        if (realIndex === currentIndex) {
          ind.classList.add('bg-primary');
          ind.classList.remove('bg-border');
        } else {
          ind.classList.remove('bg-primary');
          ind.classList.add('bg-border');
        }
      });
    }

    // Wheel navigation (desktop only — mobile uses native snap scroll)
    carousel.addEventListener('wheel', (e: WheelEvent) => {
      if (window.innerWidth < 768) return;
      const delta = e.deltaY;

      if (Math.abs(delta) > 5) {
        e.preventDefault();
        e.stopPropagation();

        if (delta > 0) {
          scrollToCard(currentIndex + 1);
        } else {
          scrollToCard(currentIndex - 1);
        }
      }
    }, { passive: false });

    // Track scroll position to update index (CSS snap nativo hace el resto)
    let scrollTimeout: ReturnType<typeof setTimeout>;

    function syncCurrentIndex() {
      const isDesktop = window.innerWidth >= 768;
      const scrollPos = isDesktop ? carousel.scrollTop : carousel.scrollLeft;
      const containerCenter = isDesktop ? carousel.clientHeight / 2 : carousel.clientWidth / 2;

      let closest = 0;
      let minDist = Infinity;

      cards.forEach((card, i) => {
        const el = card as HTMLElement;
        const cardPos = isDesktop
          ? el.offsetTop + el.offsetHeight / 2
          : el.offsetLeft + el.offsetWidth / 2;
        const dist = Math.abs(cardPos - scrollPos - containerCenter);
        if (dist < minDist) {
          minDist = dist;
          closest = i;
        }
      });

      if (closest !== currentIndex) {
        currentIndex = closest;
        updateIndicators();
      }
    }

    carousel.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(syncCurrentIndex, 50);
    }, { passive: true });

    // scrollend: sync más confiable donde esté disponible
    if ('onscrollend' in carousel) {
      carousel.addEventListener('scrollend', syncCurrentIndex, { passive: true });
    }

    // Keyboard navigation
    carousel.setAttribute('tabindex', '0');
    carousel.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
        e.preventDefault();
        scrollToCard(currentIndex + 1);
      } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
        e.preventDefault();
        scrollToCard(currentIndex - 1);
      }
    });

    // Touch swipe: delegado al snap-scroll nativo de CSS (scroll-snap-stop: always)
    // El navegador gestiona el desplazamiento una-tarjeta-por-gesto.

    updateIndicators();

    // Restaurar el centro del carrusel al volver desde el detalle de un proyecto.
    // astro:after-swap se dispara dentro del callback de startViewTransition,
    // ANTES de capturar el snapshot: centrar con behavior:'auto' (instant) logra que
    // el morph de la imagen compartida aterrice justo sobre la card ya centrada,
    // sin salto posterior. Se consume una sola vez (no debe reaparecer en futuras
    // visitas directas a Projects).
    try {
      const lastSlug = sessionStorage.getItem('lastProjectSlug');
      if (lastSlug) {
        sessionStorage.removeItem('lastProjectSlug');
        const card = carousel.querySelector<HTMLAnchorElement>(
          `a[data-project-slug="${cssEscape(lastSlug)}"]`,
        );
        if (card) {
          const i = Array.from(cards).indexOf(card);
          if (i >= 0) centerCardByIndex(i, 'auto');
        }
      }
    } catch {}
  }

  document.addEventListener('astro:after-swap', initCarousel);
  initCarousel();
</script>
