---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const projectEntries = await getCollection('projects');
const projects = projectEntries.map((entry) => ({
  id: entry.id,
  ...entry.data[lang] || entry.data['es'],
}));
---

<section id="projects" class="w-full md:min-w-[100vw] min-h-screen h-auto md:h-screen flex items-center justify-center shrink-0 snap-start px-0 md:px-16 py-0">
  <div class="flex flex-col md:flex-row items-center justify-center w-full max-w-[1400px] mx-auto gap-8 md:gap-16 h-full">

    <!-- Projects Carousel -->
    <div class="w-full md:w-1/2 h-full relative order-1 md:order-1">
      <div class="flex flex-col items-center h-full">
        <!-- Carousel scroll container -->
        <div
          id="projects-carousel"
          class="w-full h-full flex items-center md:items-stretch md:flex-col gap-4 overflow-x-auto md:overflow-x-hidden md:overflow-y-auto snap-x md:snap-y snap-mandatory scroll-smooth p-1 md:p-2"
          style="-ms-overflow-style: none; scrollbar-width: none;"
        >
          <!-- Spacer: allows first card to center -->
          <div class="flex-shrink-0 w-0 h-[calc(50%-144px)]" aria-hidden="true" />

          {projects.map((project) => (
            <a
              href={translatePath(`/projects/${project.id}`)}
              aria-label={`Open project: ${project.name}`}
              class="flex-shrink-0 w-[min(85vw,288px)] md:w-[clamp(288px,30vw,578px)] aspect-square snap-center rounded-[32px] overflow-hidden relative group cursor-pointer shadow-layer-2 hover:shadow-layer-2-hover transition-all duration-500 ease-spatial md:hover:scale-[1.02] will-change-transform isolate block"
              style={`view-transition-name: project-card-${project.id};`}
            >
              {project.images?.[0] ? (
                <img
                  src={project.images[0]}
                  alt={project.name}
                  style={`view-transition-name: project-${project.id}-gallery;`}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="absolute inset-0 bg-elevated" />
              )}

              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />

              <div class="absolute bottom-0 left-0 right-0 p-6 md:p-8">
                <h3 class="text-2xl md:text-4xl font-bold text-white font-display mb-1">{project.name}</h3>
                <p class="text-base md:text-lg text-white/70">{project.type}</p>
              </div>
            </a>
          ))}

          <article
            class="flex-shrink-0 w-[min(85vw,288px)] md:w-[clamp(288px,30vw,578px)] aspect-square snap-center rounded-[32px] overflow-hidden relative cursor-pointer bg-gradient-to-br from-orange-200 via-rose-200 to-indigo-200 shadow-layer-2 hover:shadow-layer-2-hover transition-all duration-500 ease-spatial md:hover:scale-[1.02] will-change-transform isolate"
          >
            <div class="absolute inset-0 flex items-center justify-center">
              <h3 class="text-2xl md:text-4xl font-medium text-primary/60 font-display text-center px-4">Más proyectos</h3>
            </div>
          </article>

        <!-- Spacer: allows last card to center -->
        <div class="flex-shrink-0 w-0 h-[calc(50%-144px)]" aria-hidden="true" />
        </div>

        <!-- Indicators: dots below carousel on mobile, right side on desktop -->
        <div id="carousel-indicators" class="flex flex-row gap-2 justify-center mt-4 md:hidden">
          {projects.map((_: any, i: number) => (
            <div
              class:list={[
                "w-2 h-2 rounded-full transition-all duration-300",
                i === 0 ? "bg-primary" : "bg-border"
              ]}
              data-index={i}
            />
          ))}
        </div>
      </div>

      <!-- Desktop indicators: right side -->
      <div id="carousel-indicators-desktop" class="hidden md:flex absolute right-[-2rem] top-1/2 -translate-y-1/2 flex-col gap-2">
        {projects.map((_: any, i: number) => (
          <div
            class:list={[
              "w-2 h-2 rounded-full transition-all duration-300",
              i === 0 ? "bg-primary h-4" : "bg-border"
            ]}
            data-index={i}
          />
        ))}
      </div>
    </div>

    <!-- Text Content -->
    <div class="w-full md:w-1/2 space-y-6 shrink-0 order-2 md:order-2 flex flex-col justify-center text-left px-8 md:px-0">
      <h2 class="text-4xl md:text-5xl font-medium tracking-tight text-primary font-display">
        {t('section.projects')}
      </h2>
      <p class="text-base text-secondary max-w-md leading-relaxed">
        {t('about.description')}<br/><br/>
        {t('about.body')}
      </p>
    </div>

  </div>
</section>

<style>
  #projects-carousel::-webkit-scrollbar {
    display: none;
  }

  /* Enforce 1:1 aspect ratio on cards as a fallback */
  #projects-carousel a {
    aspect-ratio: 1 / 1;
  }
</style>

<script>
  function initCarousel() {
    const carousel = document.getElementById('projects-carousel');
    if (!carousel) return;

    const mobileIndicators = document.querySelectorAll('#carousel-indicators > div');
    const desktopIndicators = document.querySelectorAll('#carousel-indicators-desktop > div');
    const cards = carousel.querySelectorAll('a');
    const totalCards = cards.length;
    let currentIndex = 0;
    let isAnimating = false;

    function getCardOffset(index: number): number {
      const card = cards[index] as HTMLElement;
      if (!card) return 0;
      const isDesktop = window.innerWidth >= 768;

      if (isDesktop) {
        const cardTop = card.offsetTop;
        const containerCenter = carousel.clientHeight / 2;
        const cardCenter = card.offsetHeight / 2;
        return cardTop - containerCenter + cardCenter;
      } else {
        const cardLeft = card.offsetLeft;
        const containerCenter = carousel.clientWidth / 2;
        const cardCenter = card.offsetWidth / 2;
        return cardLeft - containerCenter + cardCenter;
      }
    }

    function scrollToCard(index: number) {
      if (index < 0 || index >= totalCards || isAnimating) return;
      isAnimating = true;
      currentIndex = index;

      const offset = getCardOffset(index);
      const isDesktop = window.innerWidth >= 768;

      carousel.scrollTo({
        [isDesktop ? 'top' : 'left']: offset,
        behavior: 'smooth'
      });

      updateIndicators();

      setTimeout(() => {
        isAnimating = false;
      }, 600);
    }

    function updateIndicators() {
      const allIndicators = [...mobileIndicators, ...desktopIndicators];
      allIndicators.forEach((ind, i) => {
        const realIndex = i % mobileIndicators.length;
        if (realIndex === currentIndex) {
          ind.classList.add('bg-primary');
          ind.classList.remove('bg-border');
        } else {
          ind.classList.remove('bg-primary');
          ind.classList.add('bg-border');
        }
      });
    }

    // Wheel navigation
    carousel.addEventListener('wheel', (e: WheelEvent) => {
      const isDesktop = window.innerWidth >= 768;
      const delta = isDesktop ? e.deltaY : e.deltaX;

      if (Math.abs(delta) > 5) {
        e.preventDefault();
        e.stopPropagation();

        if (delta > 0) {
          scrollToCard(currentIndex + 1);
        } else {
          scrollToCard(currentIndex - 1);
        }
      }
    }, { passive: false });

    // Track scroll position to update index
    let scrollTimeout: ReturnType<typeof setTimeout>;
    carousel.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const isDesktop = window.innerWidth >= 768;
        const scrollPos = isDesktop ? carousel.scrollTop : carousel.scrollLeft;
        const containerCenter = isDesktop ? carousel.clientHeight / 2 : carousel.clientWidth / 2;

        let closest = 0;
        let minDist = Infinity;

        cards.forEach((card, i) => {
          const el = card as HTMLElement;
          const cardPos = isDesktop
            ? el.offsetTop + el.offsetHeight / 2
            : el.offsetLeft + el.offsetWidth / 2;
          const dist = Math.abs(cardPos - scrollPos - containerCenter);
          if (dist < minDist) {
            minDist = dist;
            closest = i;
          }
        });

        if (closest !== currentIndex) {
          currentIndex = closest;
          updateIndicators();
        }
      }, 50);
    }, { passive: true });

    // Keyboard navigation
    carousel.setAttribute('tabindex', '0');
    carousel.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
        e.preventDefault();
        scrollToCard(currentIndex + 1);
      } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
        e.preventDefault();
        scrollToCard(currentIndex - 1);
      }
    });

    // Touch swipe support for mobile
    let touchStartX = 0;
    carousel.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });

    carousel.addEventListener('touchend', (e: TouchEvent) => {
      const touchEndX = e.changedTouches[0].clientX;
      const diffX = touchStartX - touchEndX;

      if (window.innerWidth < 768 && Math.abs(diffX) > 30) {
        if (diffX > 0) {
          scrollToCard(currentIndex + 1);
        } else {
          scrollToCard(currentIndex - 1);
        }
      }
    }, { passive: true });

    updateIndicators();
  }

  document.addEventListener('astro:after-swap', initCarousel);
  initCarousel();
</script>
