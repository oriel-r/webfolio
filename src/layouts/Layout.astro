---
import { ClientRouter } from 'astro:transitions';
import { getLangFromUrl, useTranslations } from '../i18n/utils'
import '../styles/global.css'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;600&family=Plus+Jakarta+Sans:wght@300;400&display=swap" rel="stylesheet">
		<title>Oriel Romero</title>
		<ClientRouter fallback="animate" />
		<script is:inline>
			(function () {
				let glowTimeout;

				function scheduleThemeGlow(delay) {
					const root = document.documentElement;
					if (glowTimeout) window.clearTimeout(glowTimeout);
					root.classList.remove('theme-glow-ready');

					if (!root.classList.contains('dark')) return;
					if (!delay) {
						root.classList.add('theme-glow-ready');
						return;
					}

					const glowDuration = parseFloat(
						getComputedStyle(root).getPropertyValue('--duration-glow')
					) || 1400;
					glowTimeout = window.setTimeout(() => {
						if (root.classList.contains('dark')) {
							root.classList.add('theme-glow-ready');
						}
					}, glowDuration);
				}

				window.__scheduleThemeGlow = scheduleThemeGlow;

				function applyTheme() {
					const saved = localStorage.getItem('theme');
					const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					const isDark = saved === 'dark' || (!saved && prefersDark);
					document.documentElement.classList.toggle(
						'dark',
						isDark
					);
					scheduleThemeGlow(false);
				}
				applyTheme();
				window.matchMedia('(prefers-color-scheme: dark)')
					.addEventListener('change', (e) => {
						if (!localStorage.getItem('theme')) {
							document.documentElement.classList.toggle('dark', e.matches);
							scheduleThemeGlow(true);
						}
					});
				document.addEventListener('astro:after-swap', applyTheme);
			})();
		</script>
	</head>
	<body class="text-primary font-body antialiased">
		<!-- Ambient glow: capa fija global con una sub-capa por sección.
		     #ambient-glow[data-active="..."] revela la capa correspondiente
		     vía cross-fade de opacity, sincronizado con el evento `sectionChange`
		     emitido por scroll.ts. Evita el "corte" entre glows por-sección. -->
		<div id="ambient-glow" aria-hidden="true" data-active="hero">
			<div data-glow="hero"></div>
			<div data-glow="experience"></div>
			<div data-glow="projects"></div>
			<div data-glow="technologies"></div>
			<div data-glow="about"></div>
			<div data-glow="contact"></div>
		</div>
		<slot />

		<script>
			function setupAmbientGlow() {
				const glow = document.getElementById('ambient-glow');
				if (!glow || glow.dataset.bound === '1') return;
				glow.dataset.bound = '1';
				const order = ['hero', 'experience', 'projects', 'technologies', 'about', 'contact'];
				const setActive = (id) => {
					if (order.indexOf(id) >= 0) glow.dataset.active = id;
				};
				// Estado inicial desde el hash (covers primeros ms antes de que scroll.ts emita).
				const hash = window.location.hash.replace('#', '');
				setActive(hash && order.indexOf(hash) >= 0 ? hash : 'hero');
				window.addEventListener('sectionChange', ((e) => {
					const idx = e && e.detail && typeof e.detail.index === 'number' ? e.detail.index : 0;
					setActive(order[idx] || 'hero');
				}));

			}
			setupAmbientGlow();
			document.addEventListener('astro:after-swap', setupAmbientGlow);
		</script>
		<script>
			function setupThemeToggle() {
				const btn = document.getElementById('theme-toggle');
				if (!btn || btn.dataset.bound === '1') return;
				btn.dataset.bound = '1';
				btn.addEventListener('click', () => {
					const isDark = document.documentElement.classList.toggle('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
					window.__scheduleThemeGlow(isDark);
				});
			}
			setupThemeToggle();
			document.addEventListener('astro:after-swap', setupThemeToggle);
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		/* El smooth se controla via JS (scrollIntoView) para no competir con el snap */
		scroll-behavior: auto;
		/* Hide scrollbar for clean look */
		-ms-overflow-style: none;  /* IE and Edge */
  		scrollbar-width: none;  /* Firefox */
	}

	/* Hide scrollbar for Chrome, Safari and Opera */
	html::-webkit-scrollbar,
	body::-webkit-scrollbar {
		display: none;
	}

	/* Snap estricto: una sección por swipe en móvil (scroll-snap-stop: always).
	   #scroll-container es el scroller real en ambos viewports
	   (h-screen + overflow-y-scroll en móvil, h-screen + overflow-x-scroll en desktop). */
	#scroll-container {
		-webkit-overflow-scrolling: auto;          /* desactiva momentum/inercia iOS */
		overscroll-behavior: contain;              /* no propaga el swipe al body */
		touch-action: pan-y;                       /* móvil: solo swipe vertical */
		-ms-overflow-style: none;                  /* IE/Edge: hide scrollbar */
		scrollbar-width: none;                     /* Firefox: hide scrollbar */
	}

	/* Hide scrollbar for Chrome/Safari/Opera (pseudo-element, can't merge above) */
	#scroll-container::-webkit-scrollbar {
		display: none;
	}

	@media (min-width: 768px) {
		#scroll-container {
			touch-action: pan-x;                    /* desktop: solo swipe horizontal */
		}
	}
	#scroll-container > section {
		scroll-snap-stop: always;                  /* FUERZA detener en cada sección */
	}

	/* ===== Ambient glow global (cross-fade entre secciones) =====
	   Capa fija con una sub-capa por sección. Recetas migradas 1:1 desde los
	   antiguos ::before por-sección (mismos tokens, focos y opacidades).
	   z-index: -1 + position: fixed la mantienen detrás del contenido pero
	   por encima del bg del body; pointer-events: none la hace no-interactiva. */
	#ambient-glow {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}
	#ambient-glow > div {
		position: absolute;
		inset: 0;
		opacity: 0;
		/* Fallback A: cross-fade drivado por JS (sectionChange).
		   Duración bumped a --duration-glow (1400ms) con --ease-glow
		   para no anticiparse al asentamiento del scroll smooth.
		   En browsers con `animation-timeline: view()` (bloque @supports
		   más abajo) esta transition queda anulada por la animation. */
		transition: opacity var(--duration-glow) var(--ease-glow);
	}
	#ambient-glow > [data-glow="hero"] {
		background: radial-gradient(ellipse 68% 60% at 72% 45%, var(--glow-dominant), transparent 76%);
	}
	#ambient-glow > [data-glow="experience"],
	#ambient-glow > [data-glow="projects"] {
		/* secciones sin glow: capa transparente (el cross-fade disuelve el glow saliente) */
		background: none;
	}
	#ambient-glow > [data-glow="technologies"] {
		inset: -12%;
		background: radial-gradient(ellipse at center, var(--glow-dominant), transparent 80%);
	}
	:global(.dark) #ambient-glow > [data-glow="technologies"] {
		background: radial-gradient(ellipse at center, var(--glow-dominant), transparent 80%);
	}
	/* Glow Hero boosteado ×1.35 en dark (0.18 × 1.35 ≈ 0.24).
	   Mismo foco/size que light, solo subimos opacidad para más presencia. */
	:global(.dark) #ambient-glow > [data-glow="hero"] {
		background: radial-gradient(ellipse 68% 60% at 72% 45%, rgba(0, 173, 255, 0.24), transparent 76%);
	}
	#ambient-glow > [data-glow="about"] {
		background: radial-gradient(ellipse 50% 55% at 72% 50%, var(--glow-dominant), transparent 72%);
	}
	#ambient-glow > [data-glow="contact"] {
		background: radial-gradient(ellipse 55% 50% at 72% 50%, var(--glow-dominant), transparent 72%);
	}
	/* Capa activa por sección */
	#ambient-glow[data-active="hero"] > [data-glow="hero"],
	#ambient-glow[data-active="experience"] > [data-glow="experience"],
	#ambient-glow[data-active="projects"] > [data-glow="projects"],
	#ambient-glow[data-active="about"] > [data-glow="about"],
	#ambient-glow[data-active="contact"] > [data-glow="contact"] {
		opacity: 1;
	}
	#ambient-glow[data-active="technologies"] > [data-glow="technologies"] {
		opacity: 1;
	}

	/* ===== Mobile: reposiciona los focos del glow =====
	   En mobile el contenido fluye verticalmente (flex-col, items-start + pt-20),
	   centrado horizontal. Los focos calibrados para desktop (72% horizontal, 45-50%
	   vertical) caen sobre bordes vacíos. Aquí se recalibran por sección. */
	@media (max-width: 767px) {
		#ambient-glow > [data-glow="hero"] {
			background: radial-gradient(ellipse 110% 45% at 50% 78%, var(--glow-dominant), transparent 76%);
		}
		:global(.dark) #ambient-glow > [data-glow="hero"] {
			background: radial-gradient(ellipse 110% 45% at 50% 78%, rgba(0, 173, 255, 0.24), transparent 76%);
		}
		#ambient-glow > [data-glow="technologies"] {
			inset: 0;
			background: radial-gradient(ellipse 85% 38% at 50% 72%, var(--glow-dominant), transparent 80%);
		}
		:global(.dark) #ambient-glow > [data-glow="technologies"] {
			background: radial-gradient(ellipse 85% 38% at 50% 72%, var(--glow-dominant), transparent 80%);
		}
		#ambient-glow > [data-glow="about"] {
			background: radial-gradient(ellipse 85% 35% at 50% 50%, var(--glow-dominant), transparent 72%);
		}
		#ambient-glow > [data-glow="contact"] {
			background: radial-gradient(ellipse 80% 35% at 50% 40%, var(--glow-dominant), transparent 72%);
		}
	}

	/* ===== Scroll-driven upgrade (Option B) =====
	   En browsers que soportan `animation-timeline: view()`, el glow
	   se conduce por el progreso de visibilidad de cada <section> en
	   #scroll-container. Elimina la asincronía con el scroll smooth:
	   el cross-fade ocurre frame-a-frame con el desplazamiento real.
	   En browsers sin soporte (Firefox, Safari<26), las reglas
	   `data-active` + transition (fallback A) siguen funcionando. */
	@supports (animation-timeline: view()) {
		/* Exponer las timelines nombradas (definidas dentro de
		   #scroll-container) a #ambient-glow, que es un sibling. */
		body {
			timeline-scope: --sec-hero, --sec-experience, --sec-projects,
			                 --sec-technologies, --sec-about, --sec-contact;
		}

		#scroll-container > section {
			view-timeline-axis: block;                  /* mobile: vertical */
		}
		@media (min-width: 768px) {
			#scroll-container > section {
				view-timeline-axis: inline;              /* desktop: horizontal */
			}
		}
		#hero         { view-timeline-name: --sec-hero; }
		#experience   { view-timeline-name: --sec-experience; }
		#projects     { view-timeline-name: --sec-projects; }
		#technologies { view-timeline-name: --sec-technologies; }
		#about        { view-timeline-name: --sec-about; }
		#contact      { view-timeline-name: --sec-contact; }

		/* Keyframe universal: pico de opacity al 50% (= sección centrada en el viewport) */
		@keyframes ambient-glow-fade {
			0%, 100% { opacity: 0; }
			50%      { opacity: 1; }
		}

		/* Capas con glow: animadas por la timeline de SU sección */
		#ambient-glow > [data-glow="hero"],
		#ambient-glow > [data-glow="technologies"],
		#ambient-glow > [data-glow="about"],
		#ambient-glow > [data-glow="contact"] {
			/* duration 1ms es el estándar para scroll-driven animations
			   (el progreso lo controla el timeline, no el reloj). */
			animation: ambient-glow-fade 1ms linear;
		}
		#ambient-glow > [data-glow="hero"]         { animation-timeline: --sec-hero; }
		#ambient-glow > [data-glow="technologies"] { animation-timeline: --sec-technologies; }
		#ambient-glow > [data-glow="about"]        { animation-timeline: --sec-about; }
		#ambient-glow > [data-glow="contact"]      { animation-timeline: --sec-contact; }

		/* Experience y Projects: sin glow → sin animation → opacity 0 (base). */
	}

	/* View Transitions: el detalle cae como una capa desde arriba */
	::view-transition-group(root) {
		animation-duration: var(--duration-page);
		animation-timing-function: var(--ease-page);
		overflow: clip;
	}

	::view-transition-old(root),
	::view-transition-new(root) {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: clip;
	}

	@keyframes layer-slide-down {
		from { transform: translateY(-100%); opacity: 1; }
		to   { transform: translateY(0%);    opacity: 1; }
	}

	@keyframes layer-slide-up {
		from { transform: translateY(0%);    opacity: 1; }
		to   { transform: translateY(-100%); opacity: 1; }
	}

	::view-transition-old(root) {
		animation: var(--duration-page) var(--ease-page) both layer-slide-up;
	}

	::view-transition-new(root) {
		animation: var(--duration-page) var(--ease-page) both layer-slide-down;
	}

	@media (prefers-reduced-motion: reduce) {
		::view-transition-old(root),
		::view-transition-new(root) {
			animation: none;
		}
		#ambient-glow > div {
			transition: none;
		}
		#ambient-glow > [data-glow="hero"],
		#ambient-glow > [data-glow="technologies"],
		#ambient-glow > [data-glow="about"],
		#ambient-glow > [data-glow="contact"] {
			animation: none;
		}
	}

	/* Dark: hero y contact ya traen el glow de su mascota, así que el bias
	   light ambiental se apaga (opacity 0) para no duplicar halo. La capa
	   sigue en el DOM y conserva la transición de opacity (--duration-glow),
	   por lo que al alternar tema el glow se desvanece suavemente en vez de
	   cortarse. `animation: none` anula el fade scroll-driven para que la
	   transición controle el estado. Light queda intacto. */
	:global(.dark) #ambient-glow > [data-glow="hero"],
	:global(.dark) #ambient-glow > [data-glow="contact"] {
		opacity: 0;
		animation: none;
	}
</style>
