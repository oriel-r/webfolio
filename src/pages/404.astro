---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout>
	<main class="min-h-screen flex flex-col items-center justify-center text-center px-8 bg-canvas">
		<p class="font-code text-sm text-accent tracking-wider">
			{t('404.tag')}
		</p>

		<h1 class="font-display font-light text-8xl md:text-9xl tracking-tight text-primary leading-none mt-4">
			404
		</h1>

		<h2 class="font-display font-medium text-2xl md:text-3xl tracking-tight text-primary mt-6">
			{t('404.title')}
		</h2>

		<p class="text-base text-secondary max-w-md leading-relaxed mt-4">
			{t('404.description')}
		</p>

		<a
			href={translatePath('/')}
			class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-canvas text-primary border border-border hover:bg-elevated focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-focus-ring transition duration-hover ease-hover text-sm mt-10"
		>
			<span class="icon-[ic--outline-home] text-lg" aria-hidden="true"></span>
			<span>{t('404.cta')}</span>
		</a>
	</main>
</Layout>
