---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/layout/Navbar.astro";
import UxControls from "../components/ui/UxControls.astro";
import Hero from "../components/sections/Hero.astro";
import Experience from "../components/sections/Experience.astro";
import Projects from "../components/sections/Projects.astro";
import Technologies from "../components/sections/Technologies.astro";
import About from "../components/sections/About.astro";
import Contact from "../components/sections/Contact.astro";
import { useTranslations } from "../i18n/utils";
import { getCollection } from "astro:content";
import { generateHomepageLdJson, SITE_URL } from "../utils/seo";

const t = useTranslations("es");
const allSkills = await getCollection("skills");
const skillNames = allSkills.map((s) => s.data.name);
const currentUrl = `${SITE_URL}/`;
const jsonLd = generateHomepageLdJson("es", currentUrl, skillNames);
---

<Layout
	lang="es"
	title={t('site.title')}
	description={t('site.description')}
	keywords={t('site.keywords')}
	jsonLd={jsonLd}
	image="/og-image.png"
>
	<Navbar />
	<UxControls lang="es" />
	<main
		id="scroll-container"
		class="relative flex flex-col md:flex-row w-full h-screen overflow-x-hidden md:overflow-x-scroll overflow-y-scroll md:overflow-y-hidden snap-y md:snap-x snap-mandatory transition-colors duration-base ease-spatial"
	>
		<!-- The Actual Webfolio Sections -->
		<Hero />
		<Experience />
		<Projects />
		<Technologies />
		<About />
		<Contact />
	</main>
</Layout>

<script>
	import { initScroll } from "../scripts/scroll";

	document.addEventListener("astro:after-swap", initScroll);
	initScroll();
</script>
