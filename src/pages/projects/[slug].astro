---
import Layout from '../../layouts/Layout.astro';
import ProjectDetail from '../../components/project/ProjectDetail.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '../../i18n/utils';
import { getProjectSkillOverrides } from '../../utils/techIcons';
import { generateProjectPageLdJson, SITE_URL } from '../../utils/seo';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const lang: Lang = 'es';
const data = entry.data[lang] ?? entry.data['es'];
const allSkills = await getCollection('skills');
const skillOverrides = getProjectSkillOverrides(allSkills, entry.id);

const coverImage = data.media?.find((m) => m.type === 'image');
const imageUrl = coverImage?.src ?? '/og-image.png';
const currentUrl = `${SITE_URL}/projects/${entry.id}/`;
const jsonLd = generateProjectPageLdJson(entry, lang, currentUrl);
const pageTitle = `${data.name} | Oriel Romero - Backend Engineer`;
const keywords = `${data.technologies.join(', ')}, ${data.name}, Oriel Romero, backend developer, portfolio`;
---

<Layout
  lang={lang}
  title={pageTitle}
  description={data.description}
  image={imageUrl}
  imageAlt={`${data.name} - Portada del proyecto`}
  keywords={keywords}
  jsonLd={jsonLd}
  type="article"
>
  <main class="flex flex-col md:flex-row w-full h-auto md:h-screen overflow-x-hidden">
    <ProjectDetail
      slug={entry.id}
      name={data.name}
      type={data.type}
      description={data.description}
      long_description={data.long_description}
      media={data.media ?? []}
      colaborators={data.colaborators}
      technologies={data.technologies}
      skillOverrides={skillOverrides}
      role={data.role}
      demo={data.demo}
      repository={data.repository}
      back_repo={data.back_repo}
      front_repo={data.front_repo}
      lang={lang}
    />
  </main>
</Layout>
